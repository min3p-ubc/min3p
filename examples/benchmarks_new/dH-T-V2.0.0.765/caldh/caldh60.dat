! ---------------------------------------------------------------------------

!

'global control parameters'

'mineral + complex vs temperature  - batch problem'

.false.                       ;varsat_flow

.false.                       ;steady_flow

.false.                       ;fully_saturated

.false.                       ;reactive_transport



'energy balance'



'done'



! Data Block 2: geochemical system

! ---------------------------------------------------------------------------

!

'geochemical system'



!'use pitzer model'



!'use macinnes convention' 



'use new database format'



'database directory'

