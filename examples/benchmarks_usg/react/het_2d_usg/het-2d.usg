'polygon 2d delaunay mesh'

'coordinate projection'
'xz'                    !'xy' or 'yz' or 'xz'

'number of constraints'
2

!constraint 1
'constraint type'
'closed polygon with sub discretization interval'

'number of vertices'
6

'vertices coordinate'
0.0,  0.0
0.02, 0.0
0.1,  0.0
0.1,  0.2
0.02, 0.2
0.0,  0.2

'segment discretization interval'
0.001
0.01
0.01
0.01
0.001
0.01

'end of constraint'

!!constraint 2
'constraint type'
'open polygon with sub discretization interval'

'number of vertices'
2

'vertices coordinate'
0.02, 0.0
0.02, 0.2

'segment discretization interval'
0.001

'end of constraint'


'global domain mesh criteria'
