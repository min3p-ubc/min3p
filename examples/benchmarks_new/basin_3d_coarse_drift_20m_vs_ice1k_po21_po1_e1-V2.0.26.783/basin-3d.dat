! Data Block 17: control parameter of ice Sheet loading/unloading
! ---------------------------------------------------------------------------
!
'control parameters - ice sheet loading/unloading' 

'density of ice'
920.0

'scaling factor of pressure head and pore stress'
0.0d0           ;scaling factor of pressure head due to ice sheet growth
1.0d0           ;scaling factor of pore stress due to ice sheet growth
0.95d0          ;scaling factor of pressure head due to ice sheet decay
1.0d0           ;scaling factor of pore stress due to ice sheet decay

'basal temperature of ice'
0.0d0           ;basal temperature during ice sheet growth
0.0d0           ;basal temperature during ice sheet decay


!c isbc, add boundary condition indicator, relation with surface temperature
!c facpw, Scale factor for pw, used to adjust pressure head
!c facpice, Scale factor for pice, used to adjust por_stress
!c 'concentration input', reactive transport bd when ice sheet is applied


!.false.                     !constant ice sheet, NOT required
!440000.0d0                  !lsource, NOT required
!4000.0d0                    !zsource, NOT required
!2.5d0                       ! a, NOT required
!1.0d0                       ! b, NOT require
!0.0d0	                    ! logkxx, NOT required
!0.0d0	                    ! logkyy, NOT required
!0.0d0	                    ! logkzz, NOT required
!0.0d0                       ! temperature in the permafrost zone, NOT required
!1.0d3                       ! ice density, added
!1.0d3                       ! fresh water density, NOT required, already exists
!3                           ! number of stages, NOT required
!1			                 ! istage, NOT requried
!.false.                     ! boundary condition of icesheet head bd, added to surface termperature bd
!0.0d0                       ! Factor for pw, TO BE added
!1.0d0                       ! Factor for pice, TO BE added
!0.0d0   12500.0d0           ! time(1,i),time(2,i), NOT required
!0.0d0   439950.0d0          ! l(1,i),l(2,i), NOT required
!0.0d0   2000.0d0            ! h(1,i),h(2,i), NOT required 
!140000.0d0  540000.0d0      ! l1perm(1,i),l1perm(2,i), NOT required
!0.0d0   200000.0d0          ! l2perm(1,i),l2perm(2,i), NOT required
!100.0d0    100.0d0          ! thickperm(1,i),thickperm(2,i), NOT required
!2                           ! istage 
!.false.
!0.0d0                       ! Factor for pw
!1.0d0                       ! Factor for pice 
!12500.0d0  17500.0d0        ! time(1,i),time(2,i)
!439950.0d0   439950.0d0     ! l(1,i),l(2,i)
!2000.0d0   2000.0d0         ! h(1,i),h(2,i) 
!540000.0d0  540000.0d0      ! l1perm(1,i),l1perm(2,i) 
!200000.0d0   200000.0d0     ! l2perm(1,i),l2perm(2,i) 
!100.0d0    100.0d0          ! thickperm(1,i),thickperm(2,i) 
!3			    ! istage
!.true.
