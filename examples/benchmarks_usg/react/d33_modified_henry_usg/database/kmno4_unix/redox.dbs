! This is the true reaction !!!
!5 'mno4-1' -1.000  'h+1' -1.000  'o2(aq)' 0.750  'h2o' 0.500  'mno2(aq)' 1.000
 
'h2o-kmno4'  'monod'
0.000  0.000  0.000
