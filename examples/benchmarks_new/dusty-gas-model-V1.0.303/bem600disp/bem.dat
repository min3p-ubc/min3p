'hydraulic conductivity in z-direction'
2.0d-5                       ;K_zz

'specific storage coefficient'
1.0d-5

'soil hydraulic function parameters'
0.05                          ;residual saturation
3.00                          ;van genuchten - alpha
1.60                          ;van genuchten - n
0.5                           ;expn
0.0                           ;air entry pressure

'end of zone'

'confining unit'

'hydraulic conductivity in x-direction'
1.0d-6	                     ;K_xx

'hydraulic conductivity in y-direction'
1.0d-6                       ;K_yy

'hydraulic conductivity in z-direction'
1.0d-6                       ;K_zz

'specific storage coefficient'
1.0d-5

'soil hydraulic function parameters'
0.05                          ;residual saturation
4.00                          ;van genuchten - alpha
1.60                          ;van genuchten - n
0.5                           ;expn
0.0                           ;air entry pressure

'end of zone'

'upper VZ'

'hydraulic conductivity in x-direction'
5.0d-5	                     ;K_xx

'hydraulic conductivity in y-direction'
5.0d-5                       ;K_yy

'hydraulic conductivity in z-direction'
5.0d-5                       ;K_zz

'specific storage coefficient'
1.0d-5

'soil hydraulic function parameters'
0.05                          ;residual saturation
3.00                          ;van genuchten - alpha
1.60                          ;van genuchten - n
0.5                           ;expn
0.0                           ;air entry pressure

'end of zone'

'done'
