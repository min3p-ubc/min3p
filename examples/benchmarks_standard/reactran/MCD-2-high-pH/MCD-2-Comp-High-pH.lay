#!MC 1000
$!VarSet |LFDSFN1| = '"min3p\test_8.cbt"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "h+1" "cl-1" "na+1" "no3-1" "Charge Balance Error %" "Charge Balance"'
$!VarSet |LFDSFN2| = '"crunch\totcon3.out"'
$!VarSet |LFDSVL2| = '"x" "y" "z" "h+1" "cl-1" "na+1" "no3-1" "Charge Balance Error %" "Charge Balance" "X (meters)" "H+" "Cl-" "Na+" "NO3-"'
$!SETSTYLEBASE FACTORY
$!PAPER 
  BACKGROUNDCOLOR = WHITE
  ISTRANSPARENT = YES
  ORIENTPORTRAIT = NO
  SHOWGRID = YES
  SHOWRULER = YES
  SHOWPAPER = YES
  PAPERSIZE = LETTER
  PAPERSIZEINFO
    {
    LETTER
      {
      WIDTH = 8.5
      HEIGHT = 11
      LEFTHARDCLIPOFFSET = 0.125
      RIGHTHARDCLIPOFFSET = 0.125
      TOPHARDCLIPOFFSET = 0.125
      BOTTOMHARDCLIPOFFSET = 0.125
      }
    }
  RULERSPACING = ONEINCH
  PAPERGRIDSPACING = HALFINCH
  REGIONINWORKAREA
    {
    X1 = -0.05
    Y1 = -0.05
    X2 = 11.05
    Y2 = 8.55
    }
$!COLORMAP 
  CONTOURCOLORMAP = SMRAINBOW
$!COLORMAPCONTROL RESETTOFACTORY
### Frame Number 1 ###
$!READDATASET  '|LFDSFN1|' 
  INITIALPLOTTYPE = XYLINE
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL1|' 
$!REMOVEVAR |LFDSVL1|
$!REMOVEVAR |LFDSFN1|
$!READDATASET  '|LFDSFN2|' 
  INITIALPLOTTYPE = XYLINE
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  READDATAOPTION = APPEND
  RESETSTYLE = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL2|' 
$!REMOVEVAR |LFDSVL2|
$!REMOVEVAR |LFDSFN2|
$!ALTERDATA 
  EQUATION = '{Cation Equ} = ({H+}+{Na+})' 
$!ALTERDATA 
  EQUATION = '{Anion Equ} = ({Cl-}+{NO3-})' 
$!ALTERDATA 
  EQUATION = '{Cation Equ} = ({H+}+{Na+})' 
$!ALTERDATA 
  EQUATION = '{Anion Equ} = ({Cl-}+{NO3-})' 
$!ALTERDATA 
  EQUATION = '{CBE CRUNCH} =100' 
$!ALTERDATA 
  EQUATION = '{Cation Equ} = ({H+}+{Na+})' 
$!ALTERDATA 
  EQUATION = '{Anion Equ} = ({Cl-}+{NO3-})' 
$!ALTERDATA 
  EQUATION = '{Cation Equ} = ({H+}+{Na+})' 
$!ALTERDATA 
  EQUATION = '{Anion Equ} = ({Cl-}+{NO3-})' 
$!ALTERDATA 
  EQUATION = '{CBE CRUNCH} =100*({Cation Equ}-{Anion Equ})' 
$!ALTERDATA 
  EQUATION = '{Cation Equ} = ({H+}+{Na+})' 
$!ALTERDATA 
  EQUATION = '{Anion Equ} = ({Cl-}+{NO3-})' 
$!ALTERDATA 
  EQUATION = '{Cation Equ} = ({H+}+{Na+})' 
$!ALTERDATA 
  EQUATION = '{Anion Equ} = ({Cl-}+{NO3-})' 
$!ALTERDATA 
  EQUATION = '{CBE CRUNCH} =100*({Cation Equ}-{Anion Equ})/1' 
$!ALTERDATA 
  EQUATION = '{Cation Equ} = ({H+}+{Na+})' 
$!ALTERDATA 
  EQUATION = '{Anion Equ} = ({Cl-}+{NO3-})' 
$!ALTERDATA  [2]
  EQUATION = '{Cation Equ} = ({H+}+{Na+})' 
$!ALTERDATA  [2]
  EQUATION = '{Anion Equ} = ({Cl-}+{NO3-})' 
$!ALTERDATA  [2]
  EQUATION = '{CBE CRUNCH} =100*({Cation Equ}-{Anion Equ})/({Cation Equ}+{Anion Equ})' 
$!FRAMELAYOUT 
  HEADERCOLOR = RED
  XYPOS
    {
    X = 1
    Y = 0.25
    }
  WIDTH = 9
  HEIGHT = 8
$!PLOTTYPE  = XYLINE
$!FRAMENAME  = 'Frame 001' 
$!DELETELINEMAPS 
$!ACTIVELINEMAPS  =  [1-10]
$!GLOBALLINEPLOT 
  DATALABELS
    {
    DISTANCESKIP = 5
    }
  LEGEND
    {
    SHOW = YES
    TEXTSHAPE
      {
      HEIGHT = 2
      }
    BOX
      {
      BOXTYPE = NONE
      }
    XYPOS
      {
      X = 84.837
      Y = 97.129
      }
    }
$!LINEMAP  [1]
  NAME = '&DV&' 
  ASSIGN
    {
    ZONE = 1
    XAXISVAR = 1
    YAXISVAR = 4
    }
  LINES
    {
    COLOR = BLACK
    }
  SYMBOLS
    {
    SHOW = NO
    COLOR = BLUE
    FILLCOLOR = BLUE
    }
  BARCHARTS
    {
    COLOR = BLUE
    FILLCOLOR = BLUE
    }
  ERRORBARS
