	RATES
	Calcite
	  start
	   1 rem	parm(1) = A/V, 1/dm	parm(2) = exponent for m/m0
	   10 si_cc = si("Calcite")
	   20 if (m <= parm(2)  and si_cc < 0) then goto 200
	   120   moles = parm(1) * (1 - sr("Calcite"))
	   130   moles = moles * time
	   200 save moles
	  end
	Anhydrite
	  start
	   1 rem	parm(1) = A/V, 1/dm	parm(2) = exponent for m/m0
	   10 si_cc = si("Anhydrite")
	   20 if (m <= parm(2)  and si_cc < 0) then goto 200
	   120   moles = parm(1) * (1 - sr("Anhydrite"))
	   130   moles = moles * time
	   200 save moles
	  end
	Halite
	  start
	   1 rem	parm(1) = A/V, 1/dm	parm(2) = exponent for m/m0
	   10 si_cc = si("Halite")
	   20 if (m <= parm(2)  and si_cc < 0) then goto 200
	   120   moles = parm(1) * (1 - sr("Halite"))
	   130   moles = moles * time
	   200 save moles
	  end
	CH2O-H2S
	start 
	1	REM fs = salinity factor [-], sal = salinity, in [g/L]
	10 Ks = 1.62e-3     	#'hyperbolic T^a' 'so4-2'  1.62d-3  1.0d0
	12 Ks2 = 2.4e-6		#'hyperbolic T^a' 'so4-2'  2.4d-6   2.0d0
	20 Ka = 3.125e-5		#'inhibition T^a' 'o2(aq)' 3.125d-5  1.0d0
	23 Kh2s = 3.125e-5	#'inhibition T^a' 'hs-1'   3.125d-5  2.0d0
	30 qm = 27.6d-9		# effective rate constant 6.9d-9 [mol l-1 bulk s-1] for MIN3P, for PHREEQC it should be qm/0.25
	40 f1 = tot("S(6)")/(Ks + tot("S(6)")) 
	42 f11 = tot("S(6)")/(Ks2 + tot("S(6)")) 
	50 f2 = 1.0  # Ka /(Ka + tot("O2")) 
	60 f3 = Kh2s /(Kh2s + tot("S(-2)")) 
	70 rate = qm * f1 * f11 * f11 * f2 * f3 * f3 
	80 sal = 0.0e0		# Calculate the salinity (moles * molweight)
	85 fs = 1.0e0
	86 PI = 3.141592653589790
	90 sal = tot("Cl")
	100 if (sal < 0.076) then fs = 1.0
	130 if (sal > 1.41) then  fs = 0.0
	150 if (sal > 0.076 and sal < 1.41) then fs = cos(PI/180*(134.9325337*sal-10.25487256))
	155 PRINT "fs(cl-= ", tot("CL"), ")=", fs
	160 rate = rate * fs
	170 moles = rate * TIME 
	190 SAVE moles 
	200 if (sal < 1.41 and sal > 0.076) then  print "rate = ", rate, "   TIME =", TIME, "   Cl- =", sal
	        end 
	SOLUTION 1-200
