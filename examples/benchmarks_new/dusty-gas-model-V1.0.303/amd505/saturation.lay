$!XYAXIS 
  XDETAIL 1
    {
    RANGEMIN = 0
    RANGEMAX = 1
    GRSPACING = 0.25
    NUMMINORTICKS = 0
    AXISCOLOR = CUSTOM2
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 3.6
        }
      COLOR = CUSTOM2
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'Saturation [-]' 
      COLOR = CUSTOM2
      TEXTSHAPE
        {
        HEIGHT = 4
        }
      OFFSET = 5
      }
    }
$!XYAXIS 
