! ch2o-degradation - aerobic respiration - Monod-kinetics
! for comparison with COMPTRAN
!
'ch2o-o2-ct'  'monod'
0.000  0.000  0.000
4  'ch2o' -1.000  'o2(aq)' -1.000  'co3-2' 1.000  'h+1' 2.000
0.000                           !rate constant
0                               !fractional order terms
4                               !monod and threshold terms
'o2(aq)' 5.01d-5    1.0d0
'ch2o'   1.0d-5     1.0d0
'o2(aq)' 1.d-10     2.0d0
'ch2o'   1.d-10     2.0d0
0                               !inhibition and toxicity terms (aqueous phase)
0                               !inhibition and toxicity terms (solid phase)
