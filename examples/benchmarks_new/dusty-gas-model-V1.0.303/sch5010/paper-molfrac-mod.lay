    }
  BARCHARTS
    {
    COLOR = YELLOW
    FILLCOLOR = YELLOW
    }
  ERRORBARS
    {
    COLOR = YELLOW
    }
$!XYLINEAXIS 
  DEPXTOYRATIO = 1
  GRIDAREA
    {
    DRAWBORDER = YES
    }
  VIEWPORTPOSITION
    {
    X1 = 20
    Y1 = 18
    X2 = 92
    Y2 = 85
    }
$!XYLINEAXIS 
  XDETAIL 1
    {
    RANGEMIN = 0
    RANGEMAX = 0.86520662703306717
    GRSPACING = 0.2
    TICKS
      {
      TICKDIRECTION = OUT
      NUMMINORTICKS = 1
      }
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 4.5
        }
      OFFSET = 3
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'Mole fraction (-)' 
      TEXTSHAPE
        {
        FONT = HELV
        HEIGHT = 4.5
        }
      OFFSET = 8
      }
    }
$!XYLINEAXIS 
  XDETAIL 2
    {
    RANGEMIN = 0.99999427795399998
    RANGEMAX = 1.00590097904
    GRSPACING = 0.001
    TITLE
      {
      TEXTSHAPE
        {
        HEIGHT = 3.6
        }
      OFFSET = 6
      }
    AXISLINE
      {
      AXISALIGNMENT = WITHGRIDMAX
      OFFSET = 3
      }
    }
$!XYLINEAXIS 
  YDETAIL 1
    {
    RANGEMIN = 0
    RANGEMAX = 0.80000000000000004
    ISREVERSED = YES
    AUTOGRID = NO
    GRSPACING = 0.2
    TICKS
      {
      TICKDIRECTION = OUT
      NUMMINORTICKS = 1
      }
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 4.5
        }
      OFFSET = 3
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'Depth (m)' 
      TEXTSHAPE
        {
        FONT = HELV
        HEIGHT = 4.5
        }
      OFFSET = 14
      }
    }
$!LINEPLOTLAYERS 
  SHOWSYMBOLS = YES
