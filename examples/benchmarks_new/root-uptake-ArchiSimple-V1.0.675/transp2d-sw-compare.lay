#!MC 1000
$!VarSet |LFDSFN1| = '"TRANSP2D\transp-updrld_1.gsp"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "h_w" "ph_w" "s_a" "theta_a" "s_g" "theta_g" "q_root"'
$!VarSet |LFDSFN2| = '"TRANSP2D\transp-updrld_2.gsp"'
$!VarSet |LFDSVL2| = '"x" "y" "z" "h_w" "ph_w" "s_a" "theta_a" "s_g" "theta_g" "q_root"'
$!VarSet |LFDSFN3| = '"TRANSP2D-NoRoot\transp-updrld_1.gsp"'
$!VarSet |LFDSVL3| = '"x" "y" "z" "h_w" "ph_w" "s_a" "theta_a" "s_g" "theta_g" "q_root"'
$!VarSet |LFDSFN4| = '"TRANSP2D-NoRoot\transp-updrld_2.gsp"'
$!VarSet |LFDSVL4| = '"x" "y" "z" "h_w" "ph_w" "s_a" "theta_a" "s_g" "theta_g" "q_root"'
$!SETSTYLEBASE FACTORY
$!PAPER 
  BACKGROUNDCOLOR = WHITE
  ISTRANSPARENT = YES
  ORIENTPORTRAIT = NO
  SHOWGRID = YES
  SHOWRULER = YES
  SHOWPAPER = YES
  PAPERSIZE = LETTER
  PAPERSIZEINFO
    {
    LETTER
      {
      WIDTH = 8.5
      HEIGHT = 11
      LEFTHARDCLIPOFFSET = 0.125
      RIGHTHARDCLIPOFFSET = 0.125
      TOPHARDCLIPOFFSET = 0.125
      BOTTOMHARDCLIPOFFSET = 0.125
      }
    }
  RULERSPACING = ONEINCH
  PAPERGRIDSPACING = HALFINCH
  REGIONINWORKAREA
    {
    X1 = -0.05
    Y1 = -0.05
    X2 = 11.05
    Y2 = 8.55
    }
$!COLORMAP 
  CONTOURCOLORMAP = SMRAINBOW
$!COLORMAPCONTROL RESETTOFACTORY
### Frame Number 1 ###
$!READDATASET  '|LFDSFN1|' 
  INITIALPLOTTYPE = CARTESIAN2D
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL1|' 
$!REMOVEVAR |LFDSVL1|
$!REMOVEVAR |LFDSFN1|
$!FRAMELAYOUT 
  SHOWBORDER = NO
  HEADERCOLOR = RED
  XYPOS
    {
    X = 1
    Y = 0.25
    }
  WIDTH = 4
  HEIGHT = 4
$!PLOTTYPE  = CARTESIAN2D
$!FRAMENAME  = 'Frame 001' 
$!ACTIVEFIELDZONES  =  [1]
$!GLOBALRGB 
  RANGEMIN = 0
  RANGEMAX = 1
$!GLOBALCONTOUR  1
  VAR = 6
  LEGEND
    {
    XYPOS
      {
      X = 95
      }
    }
  COLORCUTOFF
    {
    RANGEMIN = 0.265405248851
    RANGEMAX = 0.367291752249
    }
  COLORMAPFILTER
    {
    CONTINUOUSCOLOR
      {
      CMIN = 0.214461997151
      CMAX = 0.418235003948
      }
    }
$!CONTOURLEVELS NEW
  CONTOURGROUP = 1
  RAWDATA
10
0.22
0.24
0.26
0.28
0.3
0.32
0.34
0.36
0.38
0.4
$!GLOBALCONTOUR  2
