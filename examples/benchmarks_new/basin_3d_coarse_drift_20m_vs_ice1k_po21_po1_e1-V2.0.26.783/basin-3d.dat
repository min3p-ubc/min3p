! basin-3d.dat
! modified 3d variably-saturated flow and reactive transport after:
! Sykes, J.; Normani, S. and Yin, Y. 2011, 
! TechReport: Hydrogeologic Modelling, University of Waterloo, 2011
! 
!
! Data Block 1: global control parameters
! ---------------------------------------------------------------------------
!
'global control parameters'
'Infiltration and 3-dimensional transient water table mounding'
.true.                        ;varsat_flow
.false.                       ;steady_flow
.false.                       ;fully_saturated
.true.                        ;reactive_transport

'density dependent flow'

'compute ice sheet loading/unloading'

'energy balance' 

'type of coupling for flow and heat equations'
'coupled'
!'semi-coupled'
!'decoupled'

!'output sparse matrix data set and rhs'
!'output sparse matrix data set and rhs at timestep'
!1

!'parallel solver configuration file'
!'solver.cfg'

!'disable output'
!'disable output of all gen files'
!'enable output of master gen file'

!'restart'
!'use distributed restart files to read'
!'use distributed restart files to write'
'use binary restart file to read'
'use binary restart file to write'

!'ignore restart time'

'append results'

'backup frequency'
100

'done'

! Data Block 2: geochemical system
! ---------------------------------------------------------------------------
!
'geochemical system'

'compute alkalinity'

'use pitzer model'

!'use macinnes convention' 

'use new database format'

'database directory'
'database'

'components'
10  ;11                            ;number of components (nc-1)
!'tracer'
'cl-1'
'br-1'
'na+1'
'k+1'
'h+1'  
'co3-2' 
'ca+2'  
'mg+2'  
'so4-2' 
'o2(aq)'


'secondary aqueous species'
11                ;number of secondary aqueous species
'hso4-' 
'co2(aq)' 
'oh-'
'hco3-'
'mgoh+'  
'caco3aq' 
'mgco3aq' 
'caso4aq'
'mghco3+'
'caoh+'
'cacl+'
  

'gases'
0                             ;number of gases 

'minerals'
8                             ;number of minerals (nm)
'halite'
'calcite'
'dolomite_diss'
'anhydrite'
'pyrite-o2'
'biotite-o2'
'chlorite-o2'
'ch2o-o2'

'sorbed species'
4
'na-x(na)'
'ca-x(na)'
'mg-x(na)'
'k-x(na)'

'excluded minerals'
0 

'done'

! Data Block 3: spatial discretization
! ---------------------------------------------------------------------------
!
'spatial discretization'

!'generate unstructured grid from structured parameters'
!'generate unstructured grid from structured boundary'
!'generate unstructured grid from file'

'read unstructured grid from file'
!'read unstructured grid from gid mesh file'

'control volume method'
'voronoi diagram'
!'median dual'

'allow obtuse cells'

'use layered mesh structure'

'cell based hydraulic conductivity'
!'cell based dispersivity for reactive transport'

'scale factor for mesh output'
1.0 1.0 25.0

'done'

! Data Block 4: time step control - global system
! ---------------------------------------------------------------------------
!
'time step control - global system'
'years'                       ;time unit
0.0d0   ;-1.00d6              ;time at start of solution
1.0d0   ;1.20d5               ;final solution time
1.0d-1  ;1.00d2               ;maximum time step
1.0d-8                        ;minimum time step

'transient maximum time step'
8
-1.0d5  -9.0d4  1.0d1
-9.0d4  -5.0d4  2.0d1
-5.0d4  0.0d0   1.0d2
0.0d0    2.0d2   1.0d-1
2.0d2    1.0d3   2.0d-1
1.0d3    2.0d3   5.0d-1
2.0d3    8.0d3   5.0d-1
8.0d3    1.2d5   1.0d-1

'done'

! Data Block 5: control parameters - local geochemistry
! ---------------------------------------------------------------------------
!
'control parameters - local geochemistry'

'newton iteration settings'
1.d-4                          ;factor for numerical differentiation
1.d-6                          ;convergence tolerance

'maximum ionic strength'
20.0d0                         ;max. ionic strength

'minimum activity for h2o'
0.2d0                          ;min. activity for h2o

'output time unit'
'hours'                        ;time unit (local chemistry)

'done'

! Data Block 6: control parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'control parameters - variably saturated flow'

'mass balance'

'input units for boundary and initial conditions'
'hydraulic head'              ;input unit

!'update viscosity'

'density model' 
'pitzer' 

'upstream factor for flow equation'
1.0d0

'user specified underrelaxation factor'
0.25d0

!'user specified underrelaxation range'
!0.0  1.0d2

!'compute underrelaxation factor'
!1000

'input units for media permeability'
'hydraulic conductivity'  
 
'input units for boundary and initial conditions'
'hydraulic head'              ;input unit

'input units for newton increment and tolerance'
'freshwater head'

!'run steady state flow in transient mode'

'tolerance for steady state'
1.0d-4                        ;relative tolerance
1.0d-4                        ;absolute tolerance

'disable density change in transient mode'

'maximum time of transient steady state'
1.0d5

'stop after transient steady state'

!'specific density change over temperature'
!0.0d0

!'use old storage derivative'

!'decouple porosity pressure change'

'allow maximum density update at first timestep'

'variable density parameters'
1000.0d0                      ;freshwater density g/L
0.688d0                       ;linear density coefficient d(rho)/d(TDS)
12                            ;max # Picard flow-RT iterations
5                             ;Picard iteration target (# iterations)
0.1d0                         ;maximum density update: Picard convergence g/L
1.0d50                        ;Courant criteria target

'newton iteration settings'
5.0d-3                        ;increment for numerical differentiation
60                            ;maxit_vs, max. number of newton iterations
5.0d-3                        ;tol_vs, convergence tolerance
0.001                         ;sw_star

'solver settings'
0                             ;level_vs, incomplete factorization level
1000                          ;msolvit_vs, max. number of solver iterations
1                             ;idetail_vs, solver information level
1.0d-9                        ;restol_vs, solver residual tolerance
1.0d-9                        ;deltol_vs, solver update tolerance

'done'

!
! Data Block 6B: control parameters - energy balance
! ---------------------------------------------------------------------------
!
'control parameters - energy balance'

'update viscosity' 
 
'viscosity model'
'sutra' 

'compute source/sink term due reactions'

!'update water thermal conductivity' 

!'non-linear density'  

!'centered weighting'

!'non-advection'

!'non-conduction'

!'non-dispersion'

!'logarithm in unknowns'
 
'reference temperature for density'
25.0d0

!'use old storage derivative'

!'decouple density temperature change'

'user specified underrelaxation factor'
0.25d0

'energy balance parameters'
-0.375d0                      ;linear density coefficient d(rho)/d(T)

!'temperature correction for solution'
!-20.0  100.0

!'maximum iterations of temperature correction'
!10

'tolerance for steady state'
1.0d-4                        ;relative tolerance
1.0d-4                        ;absolute tolerance


'newton iteration settings'
5.0d-3                        ;increment for numerical differentiation
60                            ;max. number of newton iterations
5.0d-3                        ;convergence tolerance
10.0d0                        ;maximum update in log cycles 

 
'solver settings'
1                             ;level_vs, incomplete factorization level
1000                          ;msolvit_vs, max. number of solver iterations
1                             ;idetail_vs, solver information level
1.0d-9                        ;restol_vs, solver residual tolerance
1.0d-9                        ;deltol_vs, solver update tolerance

'done'

! Data Block 7: control parameters - reactive transport
! ---------------------------------------------------------------------------
!
'control parameters - reactive transport'

'mass balance'

'spatial weighting'
'upstream'
!'centered'                    ;spatial weighting

'activity update settings'
'time_lagged'                 ;type of activity update

'tortuosity correction'
'millington'

'update porosity'
0.1

'update permeability'

'porosity threshold'
0.001  0.999

'output fluxes'

!'user specified underrelaxation factor'
!0.25d0

'newton iteration settings'
1.d-4                         ;increment h for numerical differentiation
20                            ;anticipted number of Newton iterations
60                            ;max. number of Newton iterations
2.0d0                         ;anticipated update in log cycles
4.0d0                         ;maximum update in log cycles
1.d-4                         ;convergence tolerance (global system)

'solver settings'
0                             ;incomplete factorization level
1000                          ;max. number of solver iterations
1                             ;solver information level
1.d-9                         ;solver residual tolerance
1.d-9                         ;solver update tolerance

'done'

