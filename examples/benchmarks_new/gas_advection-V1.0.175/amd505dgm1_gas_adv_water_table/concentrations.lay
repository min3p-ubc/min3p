    {
    COLOR = RED
    LINETHICKNESS = 0.6
    }
  SYMBOLS
    {
    COLOR = YELLOW
    FILLCOLOR = YELLOW
    }
  BARCHARTS
    {
    COLOR = YELLOW
    FILLCOLOR = YELLOW
    }
  ERRORBARS
    {
    COLOR = YELLOW
    }
$!XYMAP  [6]
  NAME = 'H_2S(g)' 
  ASSIGN
    {
    ZONE = 1
    XAXISVAR = 7
    YAXISVAR = 3
    XAXIS = 2
    }
  LINES
    {
    COLOR = PURPLE
    LINETHICKNESS = 0.6
    }
  SYMBOLS
    {
    COLOR = PURPLE
    FILLCOLOR = PURPLE
    }
  BARCHARTS
    {
    COLOR = PURPLE
    FILLCOLOR = PURPLE
    }
  ERRORBARS
    {
    COLOR = PURPLE
    }
$!XYMAP  [7]
  NAME = 'P' 
  ASSIGN
    {
    ZONE = 1
    XAXISVAR = 8
    YAXISVAR = 3
    XAXIS = 2
    }
  LINES
    {
    COLOR = BLACK
    LINETHICKNESS = 0.6
    }
  SYMBOLS
    {
    COLOR = RED
    FILLCOLOR = RED
    }
  BARCHARTS
    {
    COLOR = RED
    FILLCOLOR = RED
    }
  ERRORBARS
    {
    COLOR = RED
    }
$!XYMAP  [8]
  NAME = 'N_2' 
  ASSIGN
    {
    ZONE = 1
    XAXISVAR = 9
    YAXISVAR = 3
    }
  LINES
    {
    COLOR = BLACK
    LINETHICKNESS = 0.6
    }
  SYMBOLS
    {
    COLOR = GREEN
    FILLCOLOR = GREEN
    }
  BARCHARTS
    {
    COLOR = GREEN
    FILLCOLOR = GREEN
    }
  ERRORBARS
    {
    COLOR = GREEN
    }
$!XYAXIS 
  XDETAIL 1
    {
    AXISPOSITION = 14
    RANGEMIN = 0
    RANGEMAX = 1
    GRSPACING = 0.25
    NUMMINORTICKS = 1
    TICKDIRECTION = OUT
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 5
        }
      OFFSET = 3
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'Partial pressure [atm]' 
      TEXTSHAPE
        {
        HEIGHT = 6
        }
      OFFSET = 8
      }
    }
$!XYAXIS 
  XDETAIL 2
    {
    AUTOGRID = NO
    AXISPOSITION = 87
    RANGEMIN = 0.99
    RANGEMAX = 1
    GRSPACING = 0.005
    TICKDIRECTION = OUT
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 5
        }
      OFFSET = 3
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'Total pressure [atm]' 
      TEXTSHAPE
        {
        HEIGHT = 6
        }
      OFFSET = 8.5
      }
    }
$!XYAXIS 
  XDETAIL 3
    {
    AXISPOSITION = 84
    RANGEMIN = 51321.78125
    RANGEMAX = 51321.9804688
    GRSPACING = 0.05
    }
$!XYAXIS 
  YDETAIL 1
    {
    AXISPOSITION = 17
    RANGEMIN = 0
    RANGEMAX = 2
    GRSPACING = 0.25
    NUMMINORTICKS = 0
    TICKDIRECTION = OUT
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 5
        }
      OFFSET = 3
      SKIP = 2
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'Height [m]' 
      TEXTSHAPE
        {
        HEIGHT = 6
        }
      OFFSET = 10
      }
    }
$!XYAXIS 
  GRIDAREA
    {
    EXTENTS
      {
      X1 = 17
      Y1 = 14
      Y2 = 87
      }
    DRAWBORDER = YES
    }
  DEPXTOYRATIO = 1
$!ATTACHTEXT 
  XYPOS
    {
    X = 33
    Y = 80
    }
  TEXTSHAPE
    {
    FONT = HELV
    HEIGHT = 35
    }
  TEXT = 'O_2' 
$!ATTACHTEXT 
  XYPOS
    {
    X = 82.2927530264
    Y = 80
    }
  TEXTSHAPE
    {
    FONT = HELV
    HEIGHT = 35
    }
  TEXT = 'P' 
$!ATTACHTEXT 
  XYPOS
    {
    X = 27
    Y = 36
    }
  TEXTSHAPE
    {
    FONT = HELV
    HEIGHT = 35
    }
  TEXT = 'CO_2' 
$!ATTACHTEXT 
  XYPOS
    {
    X = 65.0190531937
    Y = 80
    }
  TEXTSHAPE
    {
    FONT = HELV
    HEIGHT = 35
    }
  TEXT = 'N_2' 
$!ATTACHTEXT 
  XYPOS
    {
    X = 70.2519024725
    Y = 17.5137362637
    }
  TEXTSHAPE
    {
    FONT = HELV
    HEIGHT = 35
    }
  TEXT = '(a)' 
$!REMOVEVAR |LFDSFN1|
$!SETSTYLEBASE CONFIG
