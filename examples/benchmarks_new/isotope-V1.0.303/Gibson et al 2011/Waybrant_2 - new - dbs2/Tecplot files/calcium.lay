#!MC 900
$!VarSet |LFDSFN1| = '"..\waybrant_3.gbt" "..\column data\ca.txt" "..\column data\so4.txt" "..\column data\h2s.txt" "..\column data\fe.txt" "..\column data\influent SO4.txt" "..\column data\influent Ca.txt" "..\column data\influent Fe.txt"'
$!VarSet |LFDSVL1| = '"time" "ca+2" "fe+2" "so4-2" "h+1" "co3-2" "hs-1" "ch4(aq)" "ar(aq)" "s" "zn+2" "ni+2" "mn+2" "na+1" "k+1" "mg+2" "br-1" "cl-1" "o2(aq)" "ca" "SO4" "h2s" "fe" "SO4(influent)" "Ca(influent)" "Fe(influent)"'
$!SETSTYLEBASE FACTORY
$!PAPER 
  BACKGROUNDCOLOR = WHITE
  ISTRANSPARENT = YES
  ORIENTPORTRAIT = NO
  SHOWGRID = YES
  SHOWRULER = YES
  SHOWPAPER = YES
  PAPERSIZE = LETTER
  PAPERSIZEINFO
    {
    LETTER
      {
      WIDTH = 8.5
      HEIGHT = 11
      LEFTHARDCLIPOFFSET = 0.125
      RIGHTHARDCLIPOFFSET = 0.125
      TOPHARDCLIPOFFSET = 0.125
      BOTTOMHARDCLIPOFFSET = 0.125
      }
    }
  RULERSPACING = ONEINCH
  PAPERGRIDSPACING = HALFINCH
  REGIONINWORKAREA
    {
    X1 = -0.05
    Y1 = -0.05
    X2 = 11.05
    Y2 = 8.55
    }
$!COLORMAP 
  CONTOURCOLORMAP = SMRAINBOW
$!COLORMAPCONTROL RESETTOFACTORY
### Frame Number 1 ###
$!READDATASET  '|LFDSFN1|' 
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  VARLOADMODE = BYNAME
