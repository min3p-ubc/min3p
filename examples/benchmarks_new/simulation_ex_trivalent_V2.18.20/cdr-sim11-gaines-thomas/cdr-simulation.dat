! 

! CDR-ERW basic simulation based on Beerling et al. (2024) paper:

! Enhanced weathering in the U.S. Corn Belt delivers carbon removal with agronomic benefits.

! 

! Section 1: global control parameters                                      			

! --------------------------------------------------------------------------			

!   			

'global control parameters'                                                 			

'CDR-ERW basic simulation - soil respiration only'                                        			

.true.                        ;varsat_flow                                  			

.true                         ;steady_flow               erw_comm: to get started! once the model is set up, transient flow, can be included, of course                             			

.false.                       ;fully_saturated                              			

.true.                        ;reactive_transport        erw_comm: this simulation includes water and solute uptake

.true.                        ;root_uptake



'biomixing diffusion'



'done' 

!

! Data Block 2: geochemical system

! ---------------------------------------------------------------------------

!

'geochemical system'



'use new database format'



'database directory'

'database\default'



'compute alkalinity'



!erw_comm: removed ch2o here, since it was applied for DOM in entire domain, but only at a low rate. Include soil respiration locally through minerals, see below

'components'

16                             ;number of components (nc-1)

'ca+2'                         ;component names

'mg+2'

'al+3'

'cl-1' 

'na+1'

'k+1'                          ;erw_comm: added potassium, as it is important for plant growth, for future link with APSIM

'h4sio4'

'h+1'

'o2(aq)'

'co3-2'

'po4-3'                        ;erw_comm: added phosphate, as it is important for plant growth - for future link with APSIM

'no3-1'                        ;erw_comm: added nitrate, as it is important for plant growth - for future link with APSIM, @Jony: add other N-species

'fe+2'

'fe+3'                         ;erw_comm: added Fe3+, need to consider oxidized form of Fe in soils

'mn+3'                         ;erw_comm: added Fe3+, need to consider oxidized form of Mn in soils

'ti(oh)4'		       ;erw_comm: added for the presence a minor component in the feedstock titanite

        

'secondary aqueous species'

51                             ;number of secondary aqueous species; erw_comm: updated list based on revised set of components

'feco3+'

'oh-'

'h3sio4-'

'h2sio4-2'

'mgoh+'

'mgco3aq'

'mghco3+'

'mgpo4-'

'mgh2po4+'

'mghpo4aq'

'koh'

'naoh'

'caoh+'

'cahco3+'

'caco3aq'

'cahpo4aq'

'capo4-'

'cah2po4+'

'co2(aq)'

'naco3-'

'nahco3aq'

'nahpo4-'

'khpo4-'

'aloh+2'

'al(oh)2+'

'al(oh)4-'

'al(oh)3aq'

'feoh+'

'feoh3-1'

'fehco3+'

'feco3aq'

'feh2po4+'

'feoh2aq'

'fehpo4aq'

'feoh+2'

'fehpo4+'

'fecl+2'

'fecl+'

'fecl2+'

'fecl3aq'

'feoh2+'

'feoh3aq'

'feoh4-'

'feh2po4+2'

'fe2(oh)2+4'

'fe3(oh)4+5'

'hco3-'

'h2co3aq'

'hpo4-2'

'h2po4-'

'h3po4'



'redox couples'

1                             ;number of redox couples (nr)

'fe+2'  'fe+3'                ;names of redox couples   erw_comm: added Fe(II)/Fe(III) redox couples, as we expect Fe to be present in oxidized state in aerated soils



'gases'

2                             ;number of gases

'o2(g)'                       ;names of gases

'co2(g)' 



'sorbed species of ion-exchange'

4

'na-x(na)'

'ca-x(na)'        

'mg-x(na)'  

'al-x(na)'  



'minerals'

11                             ;number of minerals

'calcite-ch'                   ;erw_comm: reported to be present in the amendment in supplementary material in Beerling et al. (2024)

'actinolite-2-td'              ;erw_comm: reported to be present in the amendment in supplementary material in Beerling et al. (2024)

'epidote-td'                   ;erw_comm: reported to be present in the amendment in supplementary material in Beerling et al. (2024)

'albite-ph-d'                  ;erw_comm: reported to be present in the amendment in supplementary material in Beerling et al. (2024)  

'quartz-td'                    ;erw_comm: reported to be present in the amendment in supplementary material in Beerling et al. (2024)

'chlorite-2-td'                ;erw_comm: reported to be present in the amendment in supplementary material in Beerling et al. (2024)

'titanite-td'                  ;erw_comm: reported to be present in the amendment in supplementary material in Beerling et al. (2024)

'ch2o-o2-td'                   ;erw_comm: soil respiration added, SOM oxidation by O2, this can be subdvided in the future into hetereotrophic and autotrophic respiration (incl.root respiration), as needed                    

'ferrihydrite'                 ;erw_comm: added secondary phases to provide solubility controls for Fe

'gibbsite(c)'                  ;erw_comm: added secondary phases to provide solubility controls for Al

'sio2(a,pt)'                   ;erw_comm: added secondary phases to provide solubility controls for Si 



'excluded minerals'            ;erw_comm: compute SIs for selected minerals to evaluate whether they might precipitate

3

'aragonite'

'magnesite'

'pyrolusite'



'done'                                                                   			

!   			

! Section 3: spatial discretization                                         			

! --------------------------------------------------------------------------			

!   			

'spatial discretization'                                                    			

1                             ;number of discretization intervals in x			

1                             ;number of control volumes in x			

0.0  1.0                      ;xmin,xmax"			

1                             ;number of discretization intervals in y      			

1                             ;number of control volumes in y               			

0.0 1.0                       ;ymin,ymax                                    "			

3                             ;number of discretization intervals in z

50                            ;erw_comm: split this up to exactly define soil zones and delineate locations of material properties below.

0.0d0  1.0d0

25

1.0d0  1.5d0

25

1.5d0  2.0d0



'done'                                                                      			

!   			

! Section 4: time step control - global system                              			

! --------------------------------------------------------------------------			

!   			

'time step control - global system'                                         			

'years'                      ;time unit    erw_comm: changed to years to make this easier to process for output, can be changed as needed                                			

0.0                          ;time at start of solution                     			

4.0                          ;final solution time                           			

0.1d0                        ;maximum time step			

1.0d-10                      ;minimum time step			



'done'			

			

!   			

! Section 5: control parameters - local geochemistry                        			

! --------------------------------------------------------------------------			

!   			

'control parameters - local geochemistry'                                   			

			

'finite minerals'                                                           			

.true.                        ;update geometrical parameters of minerals    			

			

'newton iteration settings'                                                 			

1.d-4                         ;factor for numerical differentiation         			

1.d-6                         ;convergence tolerance                        			

			

'maximum ionic strength'                                                    			

100.0d0                       ;max. ionic strength                          			

			

'minimum activity for h2o'                                                  			

0.01d0                        ;min. activity for h2o



'output time unit'                                                          			

'days'                        ;time unit (local chemistry)                  			

			

'done'                                                                      					

!   			

! Section 6: control parameters - variably saturated flow                   			

! --------------------------------------------------------------------------			

!   			

'control parameters - variably saturated flow' 

	

'mass balance'		



'iterative solver'

			

'input units for boundary and initial conditions'                           			

'hydraulic head'              ;input unit      erw_comm: changed to hydraulic head



'input units for media permeability'

'hydraulic conductivity'

			

'upstream weighting'                                                        			

.true.                       .true.                        ;upstream weight			

			

'newton iteration settings'			

1.0d-5                        ;increment for numerical differentiation			

200                           ;max. number of newton iterations			

1.0d-6                        ;convergence tolerance			

0.5                           ;sw_star			

			

'solver settings'			

1                             ;incomplete factorization level			

1000                           ;max. number of solver iterations			

2                             ;solver information level			

1.0d-11                       ;solver residual tolerance			

1.0d-11                       ;solver update tolerance			

.true.                        ;rcm ordering			

			

'done'	



!   			

! Section 7: control parameters - reactive transport                        			

! --------------------------------------------------------------------------			

!   			

'control parameters - reactive transport'   



'tortuosity correction'

'millington'

			

'mass balance settings'                                                     			

.true.                        ;compute mass balance                         			

			

'spatial weighting'                                                         			

'upstream'                    ;spatial weighting        'centered'         			

			

'activity update settings'                                                  			

'time_lagged'                 ;type of activity update                      			

							

'newton iteration settings'

1.0d-5                        ;increment h for numerical differentiation

15                            ;anticipated number of Newton iterations

50                            ;max. number of Newton iterations

1.0d0  ;2.0d0                         ;anticipated update in log cycles

2.0d0  ;5.0d0                         ;maximum update in log cycles

1.0d-5                        ;convergence tolerance (global system)

			

'solver settings'                                                           			

1                             ;incomplete factorization level               			

1000                           ;max. number of solver iterations             			

2                             ;solver information level                     			

1.d-9                         ;solver residual tolerance                    			

1.d-9                         ;solver update tolerance                      			

.true.                        ;rcm ordering                                 			

			

'done'                                                                      			

!   			

! Section 8: output control                                                 			

! --------------------------------------------------------------------------			

!   			

'output control'                                                            			

			

'output of spatial data'                                                    			

4                            ;number of output times (spatial data)    erw_comm: for the time being reduced number of output times

1.0  2.0  3.0  4.0

				

'coordinate output'			

			

'output of transient data'                                                  			

3                              ;number of output locations (transient data)  			

1                              ;timesteps between output (transient data)			

0.0   0.0     1.95d0 

0.0   0.0     1.8d0 

0.0   0.0     0.0d0 



'done'                                                                      			

