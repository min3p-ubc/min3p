    {
    RANGEMIN = 9.02790821344
    RANGEMAX = 26.8093032464
    }
  COLORMAPFILTER
    {
    CONTINUOUSCOLOR
      {
      CMIN = 0.137210696936
      CMAX = 35.7000007629
      }
    }
$!CONTOURLEVELS NEW
  CONTOURGROUP = 1
  RAWDATA
5
1.785
7.14
17.85
28.56
33.915
$!GLOBALCONTOUR  2
  COLORMAPFILTER
