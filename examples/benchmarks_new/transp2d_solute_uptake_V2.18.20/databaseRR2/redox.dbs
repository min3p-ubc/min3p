! intra-aqueous kinetic reactions - user defined
! -------------------------------------------------------------------------
!
! microbial biomass synthesis from benzene degradation and nh4 nitrification, composition c5h7.6no2p01 (N/P = 10), based on Jin and Bethke
!
'biomass-f'
9  'c6h6' -1.000  'o2(aq)' -3.125 'nh4+1' -1.300 'po4-3' -0.100 'co3-2' 1.000 'h+1' 3.300 'no3-1' 0.300  'h2o' 0.750  'biomass1' 1.000
'irreversible'

'fractional T^a'  1
'biomass1'   1.000

'hyperbolic T^a' 8
'o2(aq)' 3.125d-6   1.0d0
'c6h6'   1.0d-5     1.0d0
'nh4+1'  1.d-5      1.0d0
'po4-3'  1.d-5      1.0d0
'o2(aq)' 1.d-10     2.0d0
'c6h6'   1.d-10     2.0d0
'nh4+1'  1.d-10     2.0d0
'po4-3'  1.d-10     2.0d0

!
! Degradation of theoretical pesticide + ideal soluble organic matter to give metabolite + immobilized pesticide (immobile component)
! First order degradation rate (see Mamy et al., for example) with respect to pest conc + OM term (personal) to cope with subtratum availability
!
'Pest-degrad'
4  'Pesticide-A' -1.000  'ch2o' -1.000 'Metabolite-A' 1.000	'biomass1' 1.000
'irreversible'

'fractional T^a' 2
'Pesticide-A' 1.0000
'ch2o' 1.0000

!
! Degradation of a nematicide (from Claudio), neither other reactant nor any product
! zeroth order degradation rate
!
'Nem-degrad-0'
1  'Nematicide-A' -1.000
'irreversible'

'hyperbolic T^a' 1 
'Nematicide-A'  1.d-15     1.0d0

'activation energy' 15.0

! Degradation of a nematicide (from Claudio), neither other reactant nor any product
! First order degradation rate (see Mamy et al., for example) with respect to nematicide conc
!
'Nem-degrad'
1  'Nematicide-A' -1.000
'irreversible'

'fractional T^a' 1
'Nematicide-A' 1.0000

! Degradation of a nematicide (from Claudio), metabolite released by biodeg
! First order degradation rate (see Mamy et al., for example) with respect to nematicide conc
!
'Nem-degrad-b'
2  'Nematicide-A' -1.000 'Metabolite-A' 5.000
'irreversible'

'fractional T^a' 1
'Nematicide-A' 1.0000

!
! P org (biomass1) transformation into PO4 + 3 H+
! fast stuff for internal demo
!
'Porg-degrad'
4  'Porganique' -1.000 'ch2o' -1.000  'po4-3' 1.000 'h+1' 3.000
'irreversible'

'fractional T^a' 1
'ch2o' 1.0000
