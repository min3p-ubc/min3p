4
'sand'
0.36                           ;porosity from Dimech et al 2018

'extent of zone: all cells in polygon'
'read data'
4 ;number of nodes in polygon
0.07844020200506 0.0 0.896575225348885
0.0697246240044978 0.0 0.796955755865676 ;coordinates of polygon vertices
2.49545870592065 0.0 0.584731431551986
2.50417428392121 0.0 0.684350901035195


'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
5
'crushed anor'
0.3                           ;porosity from Dimech et al 2018 <- assumed slightly lower than Anor

'extent of zone: all cells in polygon'
'read data'
4 ;number of nodes in polygon
0.0854126644055098 0.0 0.976270800935453
0.07844020200506 0.0 0.896575225348885
2.50417428392121 0.0 0.684350901035195
2.51114674632166 0.0 0.764046476621763


'end of zone'


