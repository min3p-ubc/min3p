#!MC 900
$!VarSet |LFDSFN1| = '"verif-sutra_3.gsp"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "fh_w" "p_w" "ph_w" "rho_w" "s_w" "theta_w" "s_n" "theta_n" "temp_n"'
$!SETSTYLEBASE FACTORY
$!PAPER 
  BACKGROUNDCOLOR = WHITE
  ISTRANSPARENT = YES
  ORIENTPORTRAIT = NO
  SHOWGRID = YES
  SHOWRULER = YES
  SHOWPAPER = YES
  PAPERSIZE = LETTER
  PAPERSIZEINFO
    {
    LETTER
      {
      WIDTH = 8.5
      HEIGHT = 11
      LEFTHARDCLIPOFFSET = 0.125
      RIGHTHARDCLIPOFFSET = 0.125
      TOPHARDCLIPOFFSET = 0.125
      BOTTOMHARDCLIPOFFSET = 0.125
      }
    }
  RULERSPACING = ONEINCH
  PAPERGRIDSPACING = HALFINCH
  REGIONINWORKAREA
    {
    X1 = -0.05
    Y1 = -0.05
    X2 = 11.05
    Y2 = 8.55
    }
$!COLORMAP 
  CONTOURCOLORMAP = SMRAINBOW
$!COLORMAPCONTROL RESETTOFACTORY
### Frame Number 1 ###
$!READDATASET  '|LFDSFN1|' 
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL1|' 
$!REMOVEVAR |LFDSVL1|
$!FRAMELAYOUT 
  HEADERCOLOR = RED
  XYPOS
    {
    X = 1
    Y = 0.25
    }
  WIDTH = 9
  HEIGHT = 8
$!FRAMEMODE  = TWOD
$!FRAMENAME  = 'Frame 001' 
$!ACTIVEFIELDZONES  =  [1]
$!GLOBALCONTOUR 
  VAR = 12
  LABELS
    {
    SHOW = YES
    }
  COLORCUTOFF
    {
    RANGEMIN = 30.0276446342
    RANGEMAX = 50.0092148781
    }
  COLORMAPFILTER
    {
    CONTINUOUSCOLOR
      {
      CMIN = 20.0368595123
      CMAX = 60
      }
    }
$!CONTOURLEVELS NEW
  RAWDATA
7
25
30
35
40
45
50
55
$!FIELD  [1]
  MESH
    {
    COLOR = RED
    }
  CONTOUR
    {
    CONTOURTYPE = BOTHLINESANDFLOOD
    COLOR = BLACK
    USELIGHTINGEFFECT = YES
    }
  VECTOR
    {
    COLOR = RED
    }
  SCATTER
    {
    COLOR = RED
    }
  SHADE
    {
    COLOR = WHITE
    }
  BOUNDARY
    {
    COLOR = BLACK
    LINETHICKNESS = 0.1
    }
  VOLUMEMODE
    {
    VOLUMEOBJECTSTOPLOT
      {
      SHOWISOSURFACES = NO
      SHOWSLICES = NO
      SHOWSTREAMTRACES = NO
      }
    SURFACESTOPLOT = KPLANES
    POINTSTOPLOT = SURFACESONLY
    }
$!TWODAXIS 
  XVAR = 1
  YVAR = 3
$!VIEW FIT
$!TWODAXIS 
  GRIDAREA
    {
    EXTENTS
      {
      Y2 = 57.771
      }
    }
  DEPXTOYRATIO = 0.22
  XDETAIL
    {
    AUTOGRID = NO
    RANGEMIN = 0
    RANGEMAX = 246.0246
    GRSPACING = 25
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'RADIAL DISTANCE, IN METERS' 
      TEXTSHAPE
        {
        FONT = HELV
        HEIGHT = 2.5
        }
      }
    }
  YDETAIL
    {
    RANGEMIN = 0
    RANGEMAX = 30.003
    GRSPACING = 5
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'ELEVATION, IN METERS' 
      TEXTSHAPE
        {
        FONT = HELV
        HEIGHT = 2.5
        }
      }
    }
$!GLOBALISOSURFACE 
  ISOVALUE1 = 30.0276446342
  ISOVALUE2 = 40.0184297562
  ISOVALUE3 = 50.0092148781
$!FIELDLAYERS 
  SHOWMESH = NO
  SHOWCONTOUR = YES
$!REMOVEVAR |LFDSFN1|
$!SETSTYLEBASE CONFIG
