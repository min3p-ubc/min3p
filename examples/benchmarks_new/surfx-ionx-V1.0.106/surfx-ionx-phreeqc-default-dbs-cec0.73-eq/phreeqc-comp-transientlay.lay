$!VarSet |LFDSVL8| = '"V1" "V2" "V3" "V4" "V5" "V6" "V7" "V8" "V9" "V10" "V11" "V12" "V13" "V14" "time" "=feoh(s)" "=feoh2+(s)" "=feo-(s)" "=feozn+(s)" "=feopb+(s)" "=feohca+2(s)" "V15"'
