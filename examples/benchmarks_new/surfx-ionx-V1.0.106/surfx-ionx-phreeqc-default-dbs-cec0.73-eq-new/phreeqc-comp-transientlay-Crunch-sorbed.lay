#!MC 1000
$!VarSet |LFDSFN1| = '"surfx-ionx_1.gbb"'
$!VarSet |LFDSVL1| = '"time" "mg-x(na)" "na-x(na)" "k-x(na)" "zn-x(na)" "pb-x(na)" "ca-x(na)" "mg-Y(na)" "na-Y(na)"'
$!VarSet |LFDSFN2| = '"..\CrunchFlow\ionx_surf\MingliangEffluent2.out"'
$!VarSet |LFDSVL2| = '"time" "mg-x(na)" "na-x(na)" "k-x(na)" "zn-x(na)" "pb-x(na)" "ca-x(na)" "mg-Y(na)" "na-Y(na)" "Time (hrs)" "NaX" "NaY" "KX" "CaX2" "MgX2" "MgY2" "ZnX2" "PbX2"'
$!VarSet |LFDSFN3| = '"surfx-ionx.sel"'
$!VarSet |LFDSVL3| = '"time" "mg-x(na)" "na-x(na)" "k-x(na)" "zn-x(na)" "pb-x(na)" "ca-x(na)" "mg-Y(na)" "na-Y(na)" "Time (hrs)" "NaX" "NaY" "KX" "CaX2" "MgX2" "MgY2" "ZnX2" "PbX2" "V1" "V2" "V3" "V4" "V5" "V6" "V7" "V8" "V9" "V10" "V11" "V12" "V13" "V14" "V15" "V16" "V17" "V18" "V19" "V20" "V21"'
$!SETSTYLEBASE FACTORY
$!PAPER 
  BACKGROUNDCOLOR = WHITE
  ISTRANSPARENT = YES
  ORIENTPORTRAIT = NO
  SHOWGRID = YES
  SHOWRULER = YES
  SHOWPAPER = YES
  PAPERSIZE = LETTER
  PAPERSIZEINFO
    {
    LETTER
      {
      WIDTH = 8.5
      HEIGHT = 11
      LEFTHARDCLIPOFFSET = 0.125
      RIGHTHARDCLIPOFFSET = 0.125
      TOPHARDCLIPOFFSET = 0.125
      BOTTOMHARDCLIPOFFSET = 0.125
      }
    }
  RULERSPACING = ONEINCH
  PAPERGRIDSPACING = HALFINCH
  REGIONINWORKAREA
    {
    X1 = -0.05
    Y1 = -0.05
    X2 = 11.05
    Y2 = 8.55
    }
$!COLORMAP 
  CONTOURCOLORMAP = SMRAINBOW
$!COLORMAPCONTROL RESETTOFACTORY
### Frame Number 1 ###
$!READDATASET  '|LFDSFN1|' 
  INITIALPLOTTYPE = XYLINE
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL1|' 
$!REMOVEVAR |LFDSVL1|
$!REMOVEVAR |LFDSFN1|
$!READDATASET  '|LFDSFN2|' 
  INITIALPLOTTYPE = XYLINE
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  READDATAOPTION = APPEND
  RESETSTYLE = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL2|' 
$!REMOVEVAR |LFDSVL2|
$!REMOVEVAR |LFDSFN2|
$!ALTERDATA  [1]
  EQUATION = 'V2=V2*0.075/2' 
$!ALTERDATA  [1]
  EQUATION = 'V3=V3*0.075' 
$!ALTERDATA  [1]
  EQUATION = 'V4=V4*0.075' 
$!ALTERDATA  [1]
  EQUATION = 'V5=V5*0.075/2' 
