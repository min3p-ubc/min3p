    }
$!XYLINEAXIS 
  XDETAIL 1
    {
    COORDSCALE = LOG
    RANGEMIN = 0.01
    RANGEMAX = 200
    GRSPACING = 50
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'Time [days]' 
      }
    }
$!XYLINEAXIS 
