TITLE

 1D ion exchange

 based on PHREEQC example 11 (Parkhurst and Appelo, 1999)

UNITS

        -time                   day

        -horizontal_grid        meters

        -vertical_grid          meters

        -head                   meters

        -hydraulic_conductivity m/day

        -specific_storage       1/m

        -dispersivity           m

SOLUTION_METHOD

#        -direct_solver          true

        -iterative_solver       true

        -tolerance              1e-10

        -space_differencing     0

        -time_differencing      1.

FLOW_ONLY       false

STEADY_FLOW true

GRID

        -uniform x

                0.00000      10.0    41

        -uniform y

                0.00000      10.0    2

        -uniform z

                0.00000      1.0     2

        -print_orientation XY

#        -chemistry_dimensions XY

FLUID_PROPERTIES

        -compressibility        0.0             #1/Pa

        -density                1000.           #kg/m^3

        -viscosity              0.001           #Pa-s

        -diffusivity            0.0             #m^2/s

MEDIA

        -zone   0 0 0 10  10 1

                -porosity               0.3

                -long_dispersivity      0.1

                -trans_dispersivity     0.01

                -vertical_dispersivity  0.01

                -Kx                     1

                -Ky                     1

                -Kz                     1       # m/d

                -storage                0

SPECIFIED_HEAD_BC

        -zone   0 0 0 0 10  1

                -head                 0  3.0

                -associated_solution  0    0

        -zone   10 0 0 10 10 1

                -head                 0  0.0

                -associated_solution  0    1

FREE_SURFACE_BC false

HEAD_IC

        -zone   0. 0. 0. 10. 10. 1.

                -head   1.

CHEMISTRY_IC

        -zone   0. 0. 0. 10. 10. 1.

                -solution               1

                -exchange               1

TIME_CONTROL

        -delta_time  0  250.0    day

        -end_time       15000    day

PRINT_INITIAL

        -velocities             true

        -xyz_head               true

        -HDF_heads              true

        -xyz_chemistry          false 

PRINT_FREQUENCY

         0 

        -hdf_chemistry          15000     day

        -xyz_chemistry           3000     day

        -xyz_wells                250     day

        -bc_flow_rates          15000     day

        -xyz_components         15000     day

        -xyz_head               15000     day

        -xyz_velocity           15000     day

        -save_final_heads        true

END

