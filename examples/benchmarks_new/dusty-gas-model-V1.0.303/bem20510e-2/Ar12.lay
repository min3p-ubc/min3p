    POINTSTOPLOT = SURFACESONLY
    }
$!TWODAXIS 
  XVAR = 1
  YVAR = 3
$!VIEW FIT
$!TWODAXIS 
  GRIDAREA
    {
    EXTENTS
      {
      X1 = 12.663
      Y1 = 13
      X2 = 89.988
      Y2 = 87.461
      }
    }
  DEPXTOYRATIO = 0.15
