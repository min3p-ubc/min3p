! Test example: debugging gas advection
!
! Data Block 1: global control parameters
! ---------------------------------------------------------------------------
!
'global control parameters'
'debugging gas advection'
.true.                        ;varsat_flow
.true.                        ;steady_flow
.false.                       ;fully_saturated
.true.                        ;reactive_transport

'done'

! Data Block 2: geochemical system
! ---------------------------------------------------------------------------
'geochemical system'

'compute alkalinity'

'use new database format'

'database directory'
'min3p-database'

'define input units'
'mmol/l'

'components'
4                             ;number of components (nc-1)
'o2(aq)'                      ;component names
'n2(aq)'
'ch4(aq)'
'co2x(aq)'

'gases'
4                             ;number of gases
o2(g)                         ;names of gases
n2(g)
ch4(g)
co2x(g)

'minerals'
2                             ;number of minerals
'ch4-source'                  ;ch4 source
'co2-source'                  ;co2 source

'excluded minerals'
0                             ;number of excluded minerals (nmx)

'intra-aqueous kinetic reactions'
1
'ch4-o2yyy'

'scaling for intra-aqueous kinetic reactions'
4.433d-6

'done'

! Data Block 3: spatial discretization
! ---------------------------------------------------------------------------
'spatial discretization'
1                             ;number of discretization intervals in x
1                             ;number of control volumes in x
0.0 1.0                       ;xmin,xmax
1                             ;number of discretization intervals in y
1                             ;number of control volumes in y
0.0 1.0                       ;zmin,zmax
1                             ;number of discretization intervals in z
20                            ;number of control volumes in z
0.0 0.5                       ;zmin,zmax

'done'

! Data Block 4: time step control - global system
! ---------------------------------------------------------------------------
'time step control - global system'
'seconds'                        ;time unit
0.0                              ;time at start of solution
1.0d+7                           ;final solution time
1.0d+4                           ;maximum time step
1.d-10                           ;minimum time step
'done'

! Data Block 5: control parameters - local geochemistry
! ---------------------------------------------------------------------------

'control parameters - local geochemistry'

'newton iteration settings'
1.d-4                         ;factor for numerical differentiation
1.d-6                         ;convergence tolerance

'maximum ionic strength'
5.0d0                         ;max. ionic strength

'minimum activity for h2o'
0.5d0                         ;min. activity for h2o

'done'
!
! Data Block 6: control parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'control parameters - variably saturated flow'

'mass balance'

'input units for boundary and initial conditions'
'hydraulic head'              ;input unit

'solver settings'
0                             ;level_vs, incomplete factorization level
100                           ;msolvit_vs, max. number of solver iterations
0                             ;idetail_vs, solver information level
1.0d-7                        ;restol_vs, solver residual tolerance
1.0d-7                        ;deltol_vs, solver update tolerance

'done'

!
! Data Block 7: control parameters - reactive transport
! ---------------------------------------------------------------------------
!
'control parameters - reactive transport'

'mass balance'

'spatial weighting'
'centered'                    ;spatial weighting

'activity update settings'
'no update'                 ;type of activity update

'tortuosity correction'
'no correction'

'gas tortuosity correction'
'moldrup repacked'

'newton iteration settings'
1.d-4                         ;increment h for numerical differentiation
30                            ;anticipated number of Newton iterations
45                            ;max. number of Newton iterations
0.8d0                         ;anticipated update in log cycles
1.0d0                         ;maximum update in log cycles
1.d-10                        ;convergence tolerance (global system)

'solver settings'
0                             ;incomplete factorization level
100                           ;max. number of solver iterations
0                             ;solver information level
1.d-9                         ;solver residual tolerance
1.d-9                         ;solver update tolerance

!'skipped time steps in log file'
!50

'gas advection'

'done'
!
! Data Block 8: output control
! ---------------------------------------------------------------------------
!
'output control'

'output of spatial data'
3                                 ;number of output times (spatial data)
1.000d+2  1.000d+6  1.000d+7     ;specified output times (spatial data)

'output of transient data'
3                             ;number of output locations (transient data)
100                           ;timesteps between output (transient data)
1 10 20                       ;control volume numbers (transient data)

'done'
!
! Data Block 9: physical parameters - porous medium
! ---------------------------------------------------------------------------
!
'physical parameters - porous medium'
1                             ;number of property zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'aquifer'
0.5878                          ;porosity

'extent of zone'
0.0 1.0  0.0 1.0  0.0 0.5

'end of zone'

'done'
!
! Data Block 10: physical parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'physical parameters - variably saturated flow'

! ---------------------------------------------------------------------------
'aquifer'

'hydraulic conductivity in x-direction'
1.961330d-06                 ;K_xx

'hydraulic conductivity in y-direction'
1.961330d-06                 ;K_yy

'hydraulic conductivity in z-direction'
1.961330d-06                 ;K_zz

'specific storage coefficient'
1.0d-5

'soil hydraulic function parameters'
0.05                          ;residual saturation
3.50                          ;van genuchten - alpha
1.40                          ;van genuchten - n
0.5                           ;expn
0.0                           ;air entry pressure

'end of zone'

'done'
!
! Data Block 11: physical parameters - reactive transport
! ---------------------------------------------------------------------------
!
'physical parameters - reactive transport'

'diffusion coefficients'
0.0d-0                         ;aqueous phase
1.8d-5                         ;gaseous phase

'maxwell stefan'
'equimolar'
2.083d-5                       ;o2-n2
2.263d-5                       ;o2-ch4
1.635d-5                       ;o2-co2
2.137d-5                       ;n2-ch4
1.649d-5                       ;n2-co2
1.705d-5                       ;ch4-co2

'wilke viscosity'
2.04d-5                        ;o2
1.75d-5                        ;n2
1.09d-5                        ;ch4
1.46d-5                        ;co2x

! ---------------------------------------------------------------------------
'aquifer'

'longitudinal dispersivity'
0.0d0

'end of zone'

'done'
!
! Data Block 12: initial condition - variably saturated flow
! ---------------------------------------------------------------------------
!
'initial condition - variably saturated flow'
1                              ;number of zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'zone 1'

'initial condition'
-8.0                         ;hydraulic head

'extent of zone'
0.0 1.0  0.0 1.0  0.0 0.5

'end of zone'

'done'
!
! Data Block 13: boundary conditions - variably saturated flow
! ---------------------------------------------------------------------------
!
'boundary conditions - variably saturated flow'
2                             ;number of zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'upper boundary'

'boundary type'
'first'  -7.5d0               ;hydraulic head

'extent of zone'
0.0 1.0  0.0 1.0  0.49 0.5

'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
2
'lower boundary'

'boundary type'
'first' -8.0d0              ;hydraulic head

'extent of zone'
0.0 1.0  0.0 1.0  0.0 0.01

'end of zone'

'done'
!
! Data Block 15: initial conditions - reactive transport
! ---------------------------------------------------------------------------
!
'initial condition - reactive transport'
2                             ;number of zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'background chemistry'

'concentration input'
0.001       'po2'              ;'o2(aq)'
0.001       'pn2'              ;'n2(aq)'
0.499       'pch4'             ;'ch4(aq)'
0.499       'pco2x'            ;'co2(aq)'

'guess for ph'
7.0d0

'mineral input'
0.00d0    .false. 'constant'  ;phim, minequil, update_type  - ch4-source
1.00d-10  1.0d-100 0.00d0     ;phimin, area, supsatm
0.00d0    .false. 'constant'  ;phim, minequil, update_type  - co2-source
1.00d-10  1.0d-100 0.00d0     ;phimin, area, supsatm

'extent of zone'
0.0 1.0  0.0 1.0  0.01 0.5

'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
2
'ch4 source'

'concentration input'
0.001       'po2'              ;'o2(aq)'
0.001       'pn2'              ;'n2(aq)'
0.499       'pch4'             ;'ch4(aq)'
0.499       'pco2x'            ;'co2(aq)'

'guess for ph'
7.0d0

'mineral input'
1.0d3   .false.   'constant'  ;phim, minequil, update_type  - ch4-source
1.00d-10  1.1787d-5   0.00d0    ;phimin, area, supsatm
1.0d3   .false.   'constant'  ;phim, minequil, update_type  - ch4-source
1.00d-10  1.1787d-5   0.00d0    ;phimin, area, supsatm

'extent of zone'
0.0 1.0  0.0 1.0  0.0 0.01

'end of zone'

'done'

!
! Data Block 16: boundary conditions - reactive transport
! ---------------------------------------------------------------------------
!
'boundary conditions - reactive transport'
2                             ;number of zones
! ---------------------------------------------------------------------------
'number and name of zone'
1
'upper boundary - rt'

'boundary type'
'first'

'concentration input'
0.21       'po2'              ;'o2(aq)'
0.78       'pn2'              ;'n2(aq)'
1.0d-10    'pch4'             ;'ch4(aq)'
0.01       'pco2x'            ;'co2(aq)'

'guess for ph'
7.2

'extent of zone'
0.0 1.0  0.0 1.0  0.5  0.5

'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
2
'lower boundary - rt'

'boundary type'
'second'

'extent of zone'
0.0 1.0  0.0 1.0  0.0 0.0     ;extent of zone

'end of zone'

'done'
