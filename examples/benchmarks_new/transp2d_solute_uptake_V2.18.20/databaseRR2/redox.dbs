!
! Network s1 + 2
! SOM-p1 production from FOM
!
'FOMtoSOMP1'
1  'SOM-p1' 1.000
'irreversible'

!
! Networks 1 + 2
! biomass transformation into SOM-p1
!    **um transformation factor = 1.0 **um
!      and not 0.3 as specified in the benchmark doc...
!
'bio-SOMP1'
2  'biomass1' -1.000 'SOM-p1' 1.000
'irreversible'

'fractional T^a' 1
'biomass1' 1.0000

!
! Network 1
! SOM-p1 transformation into SOM-p2 + inorganic C + PROTONS + biomass
!         transformation factor 1 (rp1-p2) = 0.1
!         transformation factor 2 (rp1-I) = 0.6
!         transformation factor 3 (rp1-B) = 0.3
!
'P1-P2+IH+bio'
5  'SOM-p1' -1.000 'SOM-p2' 0.100 'co3-2' 0.600 'biomass1' 0.300 'h+1' 1.200 
'irreversible'

'fractional T^a' 1
'SOM-p1' 1.0000

!
! Network 1
! SOM-p2 transformation into biomass + inorganic C + PROTONS
!         transformation factor 1 (rp2-B) = 0.4
!         transformation factor 2 (rp2-I) = 0.6
!
'P2tobio+IH'
4  'SOM-p2' -1.00 'biomass1' 0.400 'co3-2' 0.600  'h+1' 1.200
'irreversible'

'fractional T^a' 1
'SOM-p2' 1.0000

!
! Network 1
! SOM-p1 transformation into SOM-p2 + inorganic C + PROTONS + biomass
!         Rate function of biomass
!         transformation factor 1 (rp1-p2) = 0.1
!         transformation factor 2 (rp1-I) = 0.6
!         transformation factor 3 (rp1-B) = 0.3
!
'P1-P2+IHbioB'
5  'SOM-p1' -1.000 'SOM-p2' 0.100 'co3-2' 0.600 'biomass1' 0.300 'h+1' 1.200 
'irreversible'

'fractional T^a' 2
'SOM-p1' 1.0000
'biomass1' 1.0000

