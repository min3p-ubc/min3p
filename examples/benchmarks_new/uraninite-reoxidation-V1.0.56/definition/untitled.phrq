



#Using Database minteq.V4-ns6bx
Title Combine biogenic with reox using Sani initial condition

#############################################################
Solution 1 LLM Sani
units mmol/L
C 1e-03 CO2(g) -3.5
Pip 30
Lac 30
Acetate 1.e-20
Sulfate 20 as Sulfate-2
S 1.e-20
Feii 1.e-20
Fe(3) 1.e-8 Hematite
Uranyl 0.090 #0.065 #30 mM Hematite
Ca 0.4
Mg 4
U(4) 1.e-20
Na 20 charge
Cl 8.2e-01
pH 7.2
Temperature 25.0
EQUILIBRIUM_PHASES
Hematite 0.0 7.25e-3 #15e-3 #30 mM Hematite
#Ferrihydrite  0.0 1.8e-3
Uraninite 0.0 0
#Sulfur_s 0.0 0
Mackinawite 0.0 0
Siderite 0.0 0
#S(s)  0.0 0
#pH_Fix         -7.2   Pip 30
#################################################
Rates
# rate of lactate utilizing by Sulfate  Rxn 11
# 2Lactate + sulfate = 2Acetate- + HS- + 2CO3-2 + 3H+
#or
# 2Acetate- + HS- + 2CO3-2 + 3H+ = 2Lactate + sulfate
#################################################
Lactate_u
-start
10 Ks = 2e-2 # from Aeileen 2e-2
15 logK = -2.252
16 K = 10^logK
20 Ka = 2e-2 # from Aeileen 2e-2
30 qm = -1E-8
40 f1 = MOL("Lac-")/(Ks + MOL("Lac-"))
50 f2 = MOL("Sulfate-2")/(Ka + MOL("Sulfate-2"))
52 f3 = 1 #0
53 logQ = - 2*LA("Acetate-") - 2*LA("CO3-2") - LA("HS-") - 3*LA("H+") + 2*LA("Lac-") + LA("Sulfate-2")
54 logQK = logQ -logK
55 Q = 10^logQ
56 aff = 1-(Q/K)
57 if aff < 0 then aff = -(1-(K/Q))
58 aff = -aff
#55 aff = logQK/(abs(logQK) + .1) #positive when reaction proceeds from right to left
#54 if total_time > (17*86400*tot("Uranyl")/0.00009) then f3 = 1
60 rate = qm * KIN("Biomass") * f1 * f2 * f3 * aff
70 moles = rate * TIME
80 PUT(rate, 1)
90 SAVE moles
-end
#################################################   Rxn 12

# 2Acetate + 2CO2 + 8Feii + 8H+ = 2Lactate + 8 Fe+3 + 2H2O
# Lactate + 4Fe+3 + 2H2O = Acetate- + 4Feii + CO3-2 + 6H+
#or
# Acetate- + 4Feii + CO3-2 + 6H+ = Lactate + 4Fe+3 + 2H2O
Lactate_u2
-start
10 Ks = 2e-2
15 logK = -72.652
16 K = 10^logK
30 qm = -2E-11  #-1E-11 #6E-8 too high, pH goes way up and runs out of Hem
40 f1 = MOL("Lac-")/(Ks + MOL("Lac-"))
41 f2 = 1 #Fe unlimited since hematite is present
42 f3 = 1 #0
#54 if total_time > (17*86400*tot("Uranyl")/0.00009) then f3 = 1
43 logQ = - LA("Acetate-") - LA("CO3-2") - 4*LA("Feii+2") - 6*LA("H+") + LA("Lac-") + 4*LA("Fe+3")
44 logQK = logQ -logK
45 Q = 10^logQ
46 aff = 1-(Q/K)
47 if aff < 0 then aff = -(1-(K/Q))
48 aff = -aff
#45 aff = logQK/(abs(logQK) + .1) #positive when reaction proceeds from right to left
 55 if (Equi("Hematite") < 0) then goto 90
60 rate = qm * KIN("Biomass") * f1 * f2 * f3 *aff
70 moles = rate * TIME
80 PUT(rate, 2)
90 SAVE moles

-end
# rate of generating biomass
Biomass
-start
10 Y = 1600 # testing, testing...
20 fd = -1e-8 #-1e-7 # testing...
30 rate1 = GET(1)
32 rate2 = GET(2)
40 rate = Y*(rate1 + rate2) - fd*M
50 moles = rate * TIME
#60 if (M + moles < 0) then moles = -M
70 SAVE moles
80 put(moles,3)
-end

####################################################
# sulfide reduction of U(VI) to U(IV)
# Sulfate-2 + 4U+4 + 4H2O = 4Uranyl+2 + HS- + 7H+   Rxn 13
Ureduced
-start
15 logK = -2.51
16 K = 10^logK
20 qm = -8e-11 #-3.8e-11 #-1.5e-11
#the lower the ks, the later the reox takes place
21 ks = 4e-2 #1e-4
22 f1 = MOL("Lac-")/(ks + MOL("Lac-"))
#22 f1=1
25 logQ = -4*LA("U+4") - LA("Sulfate-2") + 4*LA("Uranyl+2") + LA("HS-") + 7*LA("H+")
26 logQK = logQ -logK
27 Q = 10^logQ
28 aff = 1-(Q/K)
30 if aff < 0 then aff = -(1-(K/Q))
31 aff = -aff
#30 aff = logQK/(abs(logQK) + .1) #positive when reaction proceeds from right to left
40 f4 = 1 #default
#45 if total_time > (17*86400*tot("Uranyl")/0.00009) then f4 = 1
50 rate = qm*aff*f4*f1
60 moles = rate * TIME
65 limit1 =-TOT("S")
66 limit2 =-TOT("Uranyl")/4
#70 if(moles < limit1 ) then moles = limit1
#72 if(moles < limit2 ) then moles = limit2
80 save moles
90 put(logQK,30)
100 put(aff,31)
110 put(rate,32)
-end
#################################################
# 8Feii+2 + Sulfate-2 + 9H+ = 8Fe+3 + HS- + 4H2O  Rxn 9

Fereduced
-start
15 logK = -70.397
16 K = 10^logK
20 qm = -0.45e-11  #-1.8e-11 #-8e-10 #-1e-12 -4-10
25 logQ = -8*LA("Feii+2")-LA("Sulfate-2") - 9*LA("H+") + 8*LA("Fe+3") + LA("HS-")
26 logQK = logQ -logK
27 Q = 10^logQ
28 aff = 1-(Q/K)
30 if aff < 0 then aff = -(1-(K/Q))
31 aff = -aff
#30 aff = logQK/(abs(logQK) + .1) #positive when reaction proceeds from right to left
40 if (Equi("Hematite") < 0) then goto 80
50 rate = qm*aff
60 moles = rate * TIME
80 save moles
90 put(logQK,40)
100 put(aff,41)
110 put(rate,42)
-end
#################################################
# UO2+2 + 4H+ + 2Fe+2 = U+4 + 2Fe+3 + 2H2O   Rxn 8
Ureox
-start
15 logK = -16.972 #16.972 in tk-ureox database
16 K = 10^logK
20 qm = -2.e-11 #-1e-10 #-2.e-11 -1e-11
25 logQ = -LA("Uranyl+2")- 4*LA("H+") - 2*LA("Feii+2")+ LA("U+4") + 2*LA("Fe+3")
26 logQK = logQ - logK
27 Q = 10^logQ
28 aff = 1-(Q/K)
30 if aff < 0 then aff = -(1-(K/Q))
31 aff = -aff
#30 aff = logQK/(abs(logQK) + .1)
#34 f5 = 0
#34 if total_time > (1*86400) then f5 = 1
41 if (Equi("Hematite") < 0) then goto 110
50 rate = qm*aff #*f5
60 moles = rate*time
70 limit1 =-TOT("U")
75 limit2 =-TOT("Feii")
#90 if(moles < limit1 ) then moles = limit1
#95 if(moles < limit2 ) then moles = limit2
110 save moles
120 put(logQK,10)
130 put(aff,11)
140 put(rate,12)
-end

#################################################
# S(s) + H+ +2Feii+2 = HS- + 2Fe+3     Rxn 10
# log_k = -28.2169
Sulfur_s
-start
15 logK = -28.12
16 K = 10^logK
20 qm = -1.4e-11  #-1.4e-11 #-5e-9 #-1.4e-11
25 logQ = - LA("H+") - 2*LA("Feii+2") + 2*LA("Fe+3") + LA("HS-")
26 logQK = logQ -logK
27 Q = 10^logQ
#28 aff = (1 - logQ/logK)
28 aff = 1-(Q/K)
#30 if aff < 0 then aff = -(1-(K/Q))
31 aff = -aff   #need to leave this in since reactions are reversed
#30 aff = logQK/(abs(logQK) + .1) #positive when reaction proceeds from right to left
40 if (Equi("Hematite") < 0) then goto 80
42 if (TIME < 1000) then goto 80  #to avoid initial problems when no HS has been produced
50 rate = qm*aff
60 moles = rate * TIME
80 save moles
90 put(logQK,50)
100 put(aff,55)
110 put(rate,56)
111 put(moles,57)
-end

incremental_reactions true
Kinetics
Lactate_u  #Rxn 11  2Acetate- + HS- + 2CO3-2 + 3H+ = 2Lactate + sulfate
-formula Lac- 2 Sulfate-2 1 Acetate- -2 CO3-2 -2 HS- -1 H+ -3
-m0 0
Lactate_u2  #Rxn 12  Lactate + 4Fe+3 + 2H2O = Acetate- + 4Feii + CO3-2 + 6H+
-formula Lac- 1 H20 2 Fe+3 4 Acetate- -1 CO3-2 -1 H+ -6 Feii+2 -4
-m0 0
Biomass
-formula H 0.0 # from ex 15
-m0 3 # mg/L (use Y in mol/mg_cells/s)
Ureduced #Sulfate-2 + 4U+4 + 4H2O = 4Uranyl+2 + HS- + 7H+   Rxn 13
-formula Uranyl+2 4 HS- 1 H+ 7 U+4 -4 Sulfate-2 -1 H20 -4
-m0 0
Fereduced # 8Feii+2 + Sulfate-2 + 9H+ = 8Fe+3 + HS- + 4H2O  Rxn 9
-formula Fe+3 8 HS- 1 H2O 4 Feii+2 -8 Sulfate-2 -1 H+ -9
-m0 0
Ureox #UO2+2 + 4H+ + 2Fe+2 = U+4 + 2Fe+3 + 2H2O   Rxn 8
-formula U+4 1 Fe+3 2 H2O 2 H+ -4 Uranyl+2 -1 Feii+2 -2
-m0 0
Sulfur_s  # S(s) + H+ +2Feii+2 = HS- + 2Fe+3     Rxn 10
-formula HS- 1 Fe+3 2 H+ -1 Feii+2 -2 #S(s) -1
-m0 0

