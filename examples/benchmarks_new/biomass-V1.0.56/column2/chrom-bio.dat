4.7565d-8   ;'no3-cr6'

1.5855d-8   ;'no2-cr6'

4.0d-6      ;'no3-n2-assim'

2.0d-6      ;'no2-n2-assim'

1.250d-7    ;'c5h7o2n-dec'



'gases'

2                             ;number of gases

'co2(g)'                      ;names of gases

'n2(g)'



