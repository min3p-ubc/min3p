4 ;number of nodes in polygon
1.374739674 0.0 0.682781684058311 ;coordinates of polygon vertices
2.19162832863061 0.0 -0.191742716012369
2.42573408191615 0.0 -0.21222432431369
2.49545870592065 0.0 0.584731431551986

'end of zone'

! ---------------------------------------------------------------------------
