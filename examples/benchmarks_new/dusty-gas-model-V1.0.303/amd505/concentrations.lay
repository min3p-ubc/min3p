#!MC 1410
$!VarSet |LFDSFN1| = '"../../simulations-mpi/amd505/amd_3.gsg"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "o2(g)" "co2(g)" "h2s(g)" "n2(g)" "p_t_o_t"'
