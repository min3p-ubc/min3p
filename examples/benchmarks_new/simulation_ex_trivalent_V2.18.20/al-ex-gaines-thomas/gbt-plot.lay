$!XYLineAxis 
  DepXToYRatio = 1
$!XYLineAxis 
  XDetail 1
    {
    RangeMin = 0
    RangeMax = 24.002400000000001512
    GRSpacing = 5
    }
$!XYLineAxis 
  YDetail 1
    {
    RangeMin = 9.9999999392252902908E-09
    RangeMax = 0.0027002700690424612587
    GRSpacing = 0.0005
    }
$!FrameControl ActivateByNumber
  Frame = 1
$!SetStyleBase Config
