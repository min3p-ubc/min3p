! Data Block 10: physical parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'physical parameters - variably saturated flow'
! ---------------------------------------------------------------------------
'number and name of zone'
1
'background' 

'hydraulic conductivity in x-direction'
5.5d-4                       ;K_xx

'hydraulic conductivity in y-direction'
5.5d-4                       ;K_yy

'hydraulic conductivity in z-direction'
5.5d-4                       ;K_zz

'specific storage coefficient'
1.0d-5

'specific storage coefficient'
1.0d-5

'soil hydraulic function parameters'
0.3			 ;residual saturation
3.6				 ;van genuchten - alpha
1.56			 ;van genuchten - n
0.5				 ;expn
0.0				 ;air entry pressure
0.0				 ;max bubble entrapment

'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
2
'hi' 

'hydraulic conductivity in x-direction'
5.5d-4                       ;K_xx

'hydraulic conductivity in y-direction'
5.5d-4                       ;K_yy

'hydraulic conductivity in z-direction'
5.5d-4                       ;K_zz

'specific storage coefficient'
1.0d-5

'specific storage coefficient'
1.0d-5

'soil hydraulic function parameters'
0.47			 ;residual saturation  - adjusted from bisse's presentation (2017) and Dimech et al (2018)
5.96		     ;van genuchten - alpha
3.61			 ;van genuchten - n
0.5				 ;expn
0.0				 ;air entry pressure
0.0				 ;max bubble entrapment

'end of zone'

!-----------------------------------------------------------------------------
'number and name of zone'
3
'anor'

'hydraulic conductivity in x-direction'
5d-4                       ;K_xx

'hydraulic conductivity in y-direction'
5d-4                       ;K_yy

'hydraulic conductivity in z-direction'
5d-4                       ;K_zz

'specific storage coefficient'
1.0d-5

'specific storage coefficient'
1.0d-5

'soil hydraulic function parameters'
0.05  			 ;residual saturation  - adjusted from bisse's presentation (2017) and Dimech et al (2018)
3.6				 ;van genuchten - alpha
1.56			 ;van genuchten - n
0.5				 ;expn
0.0				 ;air entry pressure
0.0				 ;max bubble entrapment

'end of zone'

!-----------------------------------------------------------------------------
'number and name of zone'
4
'sand' 	;name of zone

'hydraulic conductivity in x-direction'
7.8d-4                       ;K_xx

'hydraulic conductivity in y-direction'
7.8d-4                       ;K_yy

'hydraulic conductivity in z-direction'
7.8d-4                       ;K_zz

'specific storage coefficient'
1.0d-5

'specific storage coefficient'
1.0d-5

'soil hydraulic function parameters'
0.18			 ;residual saturation - adjusted from bisse's presentation (2017) and Dimech et al (2018)
14.5		     ;van genuchten - alpha ; obtained from rosetta for sand
2.68			 ;van genuchten - n ; obtained from rosetta for sand 
0.5				 ;expn ; obtained from rosetta for sand
0.0				 ;air entry pressure
0.0				 ;max bubble entrapment

'end of zone'

!-----------------------------------------------------------------------------
'number and name of zone'
5
'crushed anor' 	;name of zone

'hydraulic conductivity in x-direction'
5d-5                       ;K_xx

'hydraulic conductivity in y-direction'
5d-5                       ;K_yy

'hydraulic conductivity in z-direction'
5d-5                       ;K_zz

'specific storage coefficient'
1.0d-5

'specific storage coefficient'
1.0d-5

'soil hydraulic function parameters'
0.03			 ;residual saturation - adjusted from bisse's presentation (2017) and Dimech et al (2018)
60   		     ;van genuchten - alpha ; increased from sand to account for drainage...
5   			 ;van genuchten - n ; ; increased from sand to account for drainage...
0.5				 ;expn ; obtained from rosetta for sand
0.0				 ;air entry pressure
0.0				 ;max bubble entrapment
'end of zone'


'done'


