'global control parameters'                                                 			

'Soil evaporation and salinization in soil'                                        			

.true.                        ;varsat_flow                                  			

.false.                       ;steady_flow                                  			

.false.                       ;fully_saturated                              			

.true.                        ;reactive_transport                           			

.true.                        ;plant_uptake and physical evaporation	



'root water uptake'



'done' 

!

! Data Block 2: geochemical system

! ---------------------------------------------------------------------------

!

'geochemical system'



'use new database format'



'database directory'

'database\default'



'compute alkalinity'



'components'

11                         ;number of components (nc-1)

'ca+2'                     ;component names

'mg+2'

'al+3'

'fe+2'

'cl-1' 

'na+1'

'h4sio4'

'h+1'

'o2(aq)'

'co3-2'

'ch2o' 



'secondary aqueous species'

19                             ;number of secondary aqueous species

'oh-'

'h3sio4-'

'h2sio4-2'

'mgoh+'

'mgco3aq'

'mghco3+'

'naoh'

'caoh+'

'cahco3+'

'caco3aq'

'co2(aq)'

'naco3-'

'nahco3aq'

'hco3-'

'h2co3aq'

'aloh+2'

'al(oh)2+'

'al(oh)4-'

'al(oh)3aq'



'define sorption type'

'surface-complex'



'non-aqueous components'

1                             ;number of non-aqueous components

'=feoh(s)'   'surface'        ;names of non-aqueous components



'intra-aqueous kinetic reactions'

1                             ;number of intra-aqueous kinetic reactions

'ch2o-o2'                     ;names of intra-aqueous kinetic reactions



'scaling for intra-aqueous kinetic reactions'

1.0e-12



!'sorbed species of ion-exchange'

!3

!'na-x(na)'

!'ca-x(na)'        

!'mg-x(na)'  



'sorbed species of surface-complex'

3                             ;number of sorbed species

'=feoh2+(s)'                  ;names of sorbed species

'=feo-(s)'

'=feoca+(s)'



'use molar fractions for surface complexes'



!'use electrostatic correction'

!'diffuse layer model' 

!1.06d0                        

!1.02d0



'gases'

2                             ;number of gases

'o2(g)'                       ;names of gases

'co2(g)' 



'minerals'

6                              ;number of minerals

'anorthite-ph'                 ;mineral names     

'albite-ph-d'

'augite-ph'

'ca-olivine_terr'

'ch2o(f)-2'

'calcite'   



'done'                                                                   			

