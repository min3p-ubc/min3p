'initial condition - reactive transport'
2                             ;number of zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'saturated zone chemistry'

'concentration input'
1.365d-02   'free'         ;co3-2
6.237d-04   'free'         ;n2(aq)
7.0         'ph'           ;h+1
1.000d-20   'free'         ;ch4(aq)
1.644d-05   'free'         ;ar(aq)
1.000d-20   'free'         ;c6h6
1.000d-20   'free'         ;o2(aq)
1.000d-20   'free'         ;residual(aq)

'guess for ph'
7.0

'mineral input'
1.37d-20 .false. 'constant'  ;phim, minequil, update_type  - 'ch2o(f)'
1.d-10    0.2d-8   0.00d0    ;phimin, scalfac, supsatm
