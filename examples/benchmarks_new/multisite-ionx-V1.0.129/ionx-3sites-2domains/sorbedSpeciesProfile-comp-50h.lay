#!MC 1000
$!VarSet |LFDSFN1| = '"ionx-2m_3.gsb"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "mg-x(na)" "na-x(na)" "k-x(na)" "zn-x(na)" "pb-x(na)" "ca-x(na)" "mg-Y(na)" "na-Y(na)" "k-Y(na)" "zn-Y(na)" "pb-Y(na)" "ca-Y(na)"'
$!VarSet |LFDSFN2| = '"..\CrunchFlow\ionx-2m\exchange4.out"'
