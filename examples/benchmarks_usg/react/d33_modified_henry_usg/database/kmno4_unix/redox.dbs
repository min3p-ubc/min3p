0.000                            !rate constant
1                                !fractional order terms
'kmno4' 1.000     
0                                !monod and threshold terms
0                                !inhibition and toxicity terms (aqueous phase)
0                                !inhibition and toxicity terms (solid phase)
! h2o-mno4
! oxidation of h2o by mno4-1
! first order wrt mno4-1
!
