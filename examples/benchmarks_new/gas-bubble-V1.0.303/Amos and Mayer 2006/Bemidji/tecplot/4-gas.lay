#!MC 900
$!VarSet |LFDSFN1| = '"..\gastest_1.gbg"'
$!VarSet |LFDSVL1| = '"time" "co2(g)" "n2(g)" "ar(g)" "ch4(g)" "p_t_o_t" "h_w" "p_w" "s_w" "theta_a" "s_a" "theta_g" "q_root"'
$!VarSet |LFDSFN2| = '"..\gastest_1.gbc" "..\gastest_1.gbm"'
$!VarSet |LFDSVL2| = '"time" "co2(g)" "n2(g)" "ar(g)" "ch4(g)" "p_t_o_t" "co3-2" "n2(aq)" "ar(aq)" "ch4(aq)" "h+1" "ca+2" "oh-" "hco3-" "h2co3aq" "pH" "ionic strength" "C-Alk [eq/L]" "NC-Alk [eq/L]" "Alk [eq/L]" "C-Alk [mg/L CaCO_3]" "NC-Alk [mg/L CACO_3]" "Alk [mg/L CaCO_3]" "temperature"'
$!VarSet |LFDSFN3| = '"..\gastest_1.gbs" "..\gastest_1.gbd"'
