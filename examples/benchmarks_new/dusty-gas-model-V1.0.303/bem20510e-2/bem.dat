! bemidji
! variably saturated flow and reactive transport
! 2D case with methanogenesis and oxidation
!
! Data Block 1: global control parameters
! ---------------------------------------------------------------------------
!
'global control parameters'
'Test Example - 2D case with methanogenesis'
.true.                        ;varsat_flow
.true.                        ;steady_flow
.false.                       ;fully_saturated
.true.                        ;reactive_transport

'parallel solver configuration file'
'solver.cfg'
!'restart'

'backup frequency'
25

!'output sparse matrix data set and rhs'

'done'

!
! Data Block 2: geochemical system
! ---------------------------------------------------------------------------
!
'geochemical system'

'use new database format'

'database directory'
'min3p-database20'
!'/global/home/smolins/min3p-database/min3p-database20'
!'/global/home/smolins/min3p-database/min3p-database10'
!'d:\min3p\min3p-database\min3p-database10'
!'~/min3p-database/min3p-database10'

'components'
11                  	;number of components (nc-1)
'hco3-'		;component names
'h+1'
'n2(aq)'
'o2(aq)'
'ch4(aq)'
'c7h8'
'ca+2'
'c4h10'
'ar(aq)'
'fe+2'
'mn+2'

'secondary aqueous species'
15			;number of secondary aqueous species
'oh-'			;names of secondary aqueous species
'h2co3aq'
'co3-2'
'caoh+'
'cahco3+'
'caco3aq'
'feoh+'
'feoh3-1'
'feoh2aq'
'fehco3+'
'feco3aq'
'mnco3aq'
'mnhco3+'
'mnoh+'
'mn(oh)3-1'

'gases'
7			;number of gases
'co2(g)'    'hco3-'	;names of gases
'n2(g)'     'n2(aq)'
'o2(g)'     'o2(aq)'
'ch4(g)'    'ch4(aq)'
'c7h8(g)'   'c7h8'
'c4h10(g)'  'c4h10'
'ar(g)'     'ar'    

'intra-aqueous kinetic reactions'
5                             ;number of intra-aqueous kinetic reactions
'c7h8-o2m'                    ;names of intra-aqueous kinetic reactions
'c7h8-ch4m'
'c4h10-o2m'
'ch4-o2m'
'c4h10-ch4m'

'scaling for intra-aqueous kinetic reactions'
5.0d-8               ;'c7h8-o2m'
3.75d-10             ;'c7h8-ch4-3'
5.0d-9               ;'c4h10-o2m'
5.0d-8               ;'ch4-o2m'
1.0d-10              ;'c4h10-ch4-3'

'minerals'
13			      ;number of minerals
'c7h8(r)'		      ;mineral names
'c4h10(r)'
'residual(r)'
'calcite'
'siderite(c)'
'rhodochrosit'
'feooh-c7h8m'
'feooh-c4h10m'
'mno2-c7h8m'
'mno2-c4h10m'
'ch4-sourcez'
'co2-sourcez'
'ebullition'

'combine mineralogical parameters'
'c7h8(r)'
'c4h10(r)'
'residual(r)'
'calcite'
'siderite(c)'
'rhodochrosit'
'feooh-c7h8m'
'feooh-c7h8m'
'mno2-c7h8m'
'mno2-c7h8m'
'ch4-sourcez'
'co2-sourcez'
'ebullition'

'done'

!
! Data Block 3: spatial discretization
! ---------------------------------------------------------------------------
!
'spatial discretization'
1                             ;number of discretization intervals in x
175                           ;number of control volumes in x
-75 100.0                     ;xmin,xmax
1                             ;number of discretization intervals in y
1                             ;number of control volumes in y
0. 1.0                        ;ymin,ymax
3                             ;number of discretization intervals in z
9                             ;number of control volumes in z
423.5 426.55                  ;zmin,zmax
4                             ;number of control volumes in z
426.55 427.0                  ;zmin,zmax
16                            ;number of control volumes in z
427.0 432.5                   ;zmin,zmax

'done'

!
! Data Block 4: time step control - global system
! ---------------------------------------------------------------------------
!
'time step control - global system'
'years'                      ;time unit
0.00d+0                      ;time at start of solution
28.00d+0                     ;final solution time
1.00d+0                      ;maximum time step
1.00d-10                     ;minimum time step

'done'

!
! Data Block 5: control parameters - local geochemistry
! ---------------------------------------------------------------------------
!
'control parameters - local geochemistry'

'newton iteration settings'
1.d-4                         ;factor for numerical differentiation
1.d-6                         ;convergence tolerance

'maximum ionic strength'
1.0d0                         ;max. ionic strength

'minimum activity for h2o'
0.5d0                         ;min. activity for h2o

'done'

!
! Data Block 6: control parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'control parameters - variably saturated flow'

'mass balance'

'input units for boundary and initial conditions'
'hydraulic head'              ;input unit

'solver settings'
0                             ;level_vs, incomplete factorization level
100                           ;msolvit_vs, max. number of solver iterations
0                             ;idetail_vs, solver information level
1.0d-7                        ;restol_vs, solver residual tolerance
1.0d-7                        ;deltol_vs, solver update tolerance

'done'

!
! Data Block 7: control parameters - reactive transport
! ---------------------------------------------------------------------------
!
'control parameters - reactive transport'

!'dense block matrices'

'mass balance'

'spatial weighting'
'upstream'                    ;spatial weighting

'activity update settings'
'no update'                 ;type of activity update

'tortuosity correction'
'millington'

'user specified underrelaxation factor'
0.7d0

'newton iteration settings'
1.d-4                         ;increment h for numerical differentiation
15                            ;anticipated number of Newton iterations
45                            ;max. number of Newton iterations
0.8d0                         ;anticipated update in log cycles
1.0d0                         ;maximum update in log cycles
1.d-6                         ;convergence tolerance (global system)

'solver settings'
2                             ;incomplete factorization level
100                           ;max. number of solver iterations
0                             ;solver information level
1.d-9                         ;solver residual tolerance
1.d-9                         ;solver update tolerance

'skipped time steps in log file'
0

'gas advection'

!'enable gravity for gas phase'

'done'

!
! Data Block 8: output control
! ---------------------------------------------------------------------------
!
'output control'

'output of spatial data'
12                                        ;number of output times (spatial data)
1.00d-1   1.00d+0   1.25d+0   6.00d+0     ;specified output times (spatial data)
8.0d+0    10.0d+0   15.0d+0   18.0d+0
21.0d+0   24.0d+0   26.0d+0   28.0d+0

'output of transient data'
6                             ;number of output locations (transient data)
1                            ;timesteps between output (transient data)
88     263  438  2207              ;control volume numbers (transient data)
2551  2732

'done'

