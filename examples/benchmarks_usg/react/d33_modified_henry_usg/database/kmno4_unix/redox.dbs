!
'pce-mno4-2'   'monod'
0.000  0.000  0.000
7  'c2cl4' -0.750 'mno4-1' -1.000  'h2o' -2.500  'co3-2' 1.500  'cl-1' 3.000  'h+1' 5.000  'mno2(aq)' 1.000
