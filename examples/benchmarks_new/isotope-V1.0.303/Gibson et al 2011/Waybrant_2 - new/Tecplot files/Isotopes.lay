#!MC 900
$!VarSet |LFDSFN1| = '"..\waybrant_0.gsis" "..\waybrant_1.gsis" "..\waybrant_2.gsis" "..\waybrant_3.gsis" "..\waybrant_4.gsis" "..\waybrant_5.gsis" "..\waybrant_6.gsis" "..\waybrant_7.gsis" "..\waybrant_8.gsis"'
