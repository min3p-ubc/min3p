! --------------------------------------------------------------------------			

!   			

'physical parameters - porous medium'                                       			

1                             ;number of property zones                     			

			

! --------------------------------------------------------------------------			

'number and name of zone'                                                   			

1			

'tailings'                                                                   			

			

0.3d0                         ;porosity                                     			

			

'extent of zone'                                                            			

0.0 1.0  0.0 1.0  0.0 20.0			

			

'end of zone'                                                               			

			

'done'			

!   			

! Section 10: physical parameters - variably saturated flow                 			

! --------------------------------------------------------------------------			

!   			

'physical parameters - variably saturated flow'			

'dual permeability off'			

'dual porosity off'



!'residual gas saturation'

!0.0001d0

			

! --------------------------------------------------------------------------			

'tailings'			

			

'hydraulic conductivity in x-direction'      ! conductivity adjusted to fit			

9.81d-5                      ;K_xx			



'hydraulic conductivity in y-direction'      ! conductivity adjusted to fit			

9.81d-5                      ;K_yy			

			

'hydraulic conductivity in z-direction'      			

9.81d-5                      ;K_zz			

			

'specific storage coefficient'			

0.0d0



!'oven-drying parameters'

!1.0d5           ! hm  

!1.0d-10         ! w0

!1.0             ! beta

!0.025d0         ! cte p0 



'soil hydraulic function parameters'

0.001                           ;residual saturation  !0.0001 !paramters from hydrus for sand, commented out ones from Bea's tailings model

4.0                           ;van genuchten - alpha  !0.8

6.0                           ;van genuchten - n   !1.4

0.5                          ;expn

-0.181                          ;air entry pressure  






'end of zone'





'done'

