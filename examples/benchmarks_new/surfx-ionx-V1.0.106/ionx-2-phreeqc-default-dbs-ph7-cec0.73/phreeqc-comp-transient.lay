#!MC 1000
$!VarSet |LFDSFN1| = '"ionx.sel"'
$!VarSet |LFDSVL1| = '"V1" "V2" "V3" "V4" "V5" "V6" "V7" "V8" "V9"'
$!VarSet |LFDSFN2| = '"ionx2_1.gbm"'
$!VarSet |LFDSVL2| = '"V1" "V2" "V3" "V4" "V5" "V6" "V7" "V8" "V9" "time" "pH"'
$!VarSet |LFDSFN3| = '"ionx.sel"'
$!VarSet |LFDSVL3| = '"V1" "V2" "V3" "V4" "V5" "V6" "V7" "V8" "V9"'
