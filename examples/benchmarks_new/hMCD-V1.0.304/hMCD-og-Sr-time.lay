$!VarSet |LFDSVL2| = '"time" "cs+1" "na+1" "k+1" "mg+2" "ca+2" "sr+2" "cl-1" "h+1" "o2(aq)" "so4-2" "co3-2" "i-1" "br-1" "hto" "co_60+2" "time [days]" "Cs-exp [mol/L]" "Eu-exp [mol/L]" "HTO-exp [mol/L]" "Sr-85-exp [mol/L]" "Co-60-exp [mol/L]" "I-exp [mol/L]" "Br-exp[mol/L]"'
$!VarSet |LFDSFN3| = '"hMCD_1.gbt"'
