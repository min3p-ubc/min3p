USER_PUNCH 
   -headings -head ca_mol Na_mol Mg_mol K_mol Cl_mol SO4_mol CO3_mol HS_mol pH SI_Calcite SI_Anhydrite SI_halite
10 PUNCH TOT("Ca"), TOT("Na"), TOT("Mg"), TOT("K"), TOT("Cl"), TOT("S(6)"), TOT("C"), TOT("S(-2)"), -LA("H+"), SI("Calcite"), SI("Anhydrite"), SI("Halite")
TRANSPORT 
