#!MC 900
$!VarSet |LFDSFN1| = '"bem_12.gs2"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "co2(g)" "n2(g)" "o2(g)" "ch4(g)" "c6h6(g)" "c7h8(g)" "c4h10(g)" "ar(g)"'
$!SETSTYLEBASE FACTORY
$!PAPER 
  BACKGROUNDCOLOR = WHITE
  ISTRANSPARENT = YES
  ORIENTPORTRAIT = NO
  SHOWGRID = YES
  SHOWRULER = YES
  SHOWPAPER = YES
  PAPERSIZE = LETTER
  PAPERSIZEINFO
    {
    LETTER
      {
      WIDTH = 8.5
      HEIGHT = 11
      LEFTHARDCLIPOFFSET = 0.125
      RIGHTHARDCLIPOFFSET = 0.125
      TOPHARDCLIPOFFSET = 0.125
      BOTTOMHARDCLIPOFFSET = 0.125
      }
    }
  RULERSPACING = ONEINCH
  PAPERGRIDSPACING = HALFINCH
  REGIONINWORKAREA
    {
    X1 = -0.05
    Y1 = -0.05
    X2 = 11.05
    Y2 = 8.55
    }
$!COLORMAP 
  CONTOURCOLORMAP = SMRAINBOW
$!COLORMAPCONTROL RESETTOFACTORY
### Frame Number 1 ###
$!READDATASET  '|LFDSFN1|' 
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL1|' 
$!REMOVEVAR |LFDSVL1|
$!FRAMELAYOUT 
  SHOWBORDER = NO
  ISTRANSPARENT = YES
  HEADERCOLOR = RED
  XYPOS
    {
    X = 0.5
    Y = 2
    }
  WIDTH = 10
  HEIGHT = 6
$!FRAMEMODE  = TWOD
$!FRAMENAME  = 'Frame 001' 
$!ACTIVEFIELDZONES  =  [1]
$!GLOBALCONTOUR 
  VAR = 11
  LABELS
    {
    GENERATEAUTOLABELS = NO
    AUTOLABELSPACING = 60
    TEXTSHAPE
      {
      HEIGHT = 4.5
      }
    }
  COLORCUTOFF
    {
    RANGEMIN = 0.00945
    RANGEMAX = 0.0136854202329
    INCLUDEMIN = YES
    }
  COLORMAPFILTER
    {
    CONTINUOUSCOLOR
      {
      CMIN = 0.00149976194371
      CMAX = 0.0100706024095
      }
    }
$!GLOBALCONTOUR 
  COLORMAPFILTER
    {
    COLORMAPOVERRIDEACTIVE = YES
    COLORMAPOVERRIDE 1
      {
      INCLUDE = YES
      COLOR = CUSTOM2
      STARTLEVEL = 4
      ENDLEVEL = 5
      }
    COLORMAPOVERRIDE 2
      {
      INCLUDE = YES
      COLOR = CUSTOM2
      STARTLEVEL = 5
      ENDLEVEL = 6
      }
    }
$!CONTOURLABELS ADD
  XYZPOS
    {
    X = -6.39170033763
    Y = 424.003355131
    Z = 0
    }
$!CONTOURLABELS ADD
