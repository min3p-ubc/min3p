#!MC 1000
$!VarSet |LFDSFN1| = '"surfx-ionx.sel"'
$!VarSet |LFDSVL1| = '"V1" "V2" "V3" "V4" "V5" "V6" "V7" "V8" "V9" "V10" "V11" "V12" "V13" "V14"'
$!VarSet |LFDSFN2| = '"surfx-ionx_1.gbm"'
$!VarSet |LFDSVL2| = '"V1" "V2" "V3" "V4" "V5" "V6" "V7" "V8" "V9" "V10" "V11" "V12" "V13" "V14" "time" "pH"'
$!VarSet |LFDSFN3| = '"surfx-ionx.sel"'
$!VarSet |LFDSVL3| = '"V1" "V2" "V3" "V4" "V5" "V6" "V7" "V8" "V9" "V10" "V11" "V12" "V13" "V14" "time" "pH" "V15"'
