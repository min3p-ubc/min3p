!
!Leaf recycle test
!mini (5 m) root extent
!
!solid ca-oxalate consumption rate set to consumption via Streptomyces achromogenes 
!
!
!
!Cl present as tracer for solute uptake
!No change to decomposition rxn rate
!
!Data Block 1: global control parameters
! ---------------------------------------------------------------------------
!
'global control parameters'
'plot-scale model - initial'

.true.                        ;varsat_flow
.false.                       ;steady_flow
.false.                       ;fully_saturated
.true.                        ;reactive_transport
.true.                          ;root_uptake

!'output sparse matrix data set and rhs at timestep'
!146

'done'

!
! Data Block 2: geochemical system
! ---------------------------------------------------------------------------
!
'geochemical system'

'use new database format'

'database directory'
'./databaseRR2'

'define input units'
'mol/l'

'define temperature'
25

'components'
13                            ;number of components (nc-1)
'h+1'                         ;component names
'co3-2'
'ca+2'
'o2(aq)'
'al+3'
'h4sio4'
'na+1'
'CaOxalate_aq'
'cl-1'
'fe+2'
'fe+3'
'oxalate-2B'
'ch3cooh(aq)'

'redox couples'
0                             ;number of redox couples (nr)


'secondary aqueous species'
16                            ;number of secondary aqueous species
'oh-'                         ;names of secondary aqueous species
'caco3aq'
'cahco3+'
'caoh+'
'h2co3aq'
'hco3-'
'al(oh)2+'
'al(oh)3aq'
'al(oh)4-'
'aloh+2'
'feoh+'
'feoh3-1'
'fehco3+'
'feco3aq'
'feoh2aq'
'feoh+2'
!'fecl+2'
!'fecl+'
!'fecl2+'
!'fecl3aq'
!'feoh2+'
!'feoh3aq'
!'feoh4-'
!'fe2(oh)2+4'
!'fe3(oh)4+5'
!'al13(oh)32+7'
!'al2(oh)2+4'
!'al2Sio2(oh)6aq'
!'al3(oh)4+5'
!'alh3sio4+2'
!'alsio(oh)6-'
!'h2sio4-2'
!'h3sio4-'

'gases'
2                              ;number of gases
'o2(g)'                        ;names of gases
'co2(g)'

'minerals'
6                              ;number of minerals
'calcite'                      ;minerals names
'CaOxalate_s'                  !irriversible precipitation for straight caox oxidation
'Ca_feldspar-pH'
'kaolinite'
'hematite'
'CaOxalate_ox'


'combine mineralogical parameters'
'calcite'                      ;minerals names
'CaOxalate_ox'                  !irriversible precipitation for straight caox oxidation
'Ca_feldspar-pH'
!'Ca_feld_Al'
'kaolinite'
'hematite'
'CaOxalate_ox'


'excluded minerals'
2                              ;number of excluded minerals (nmx)
'aragonite'                    ;minerals names
'vaterite'
!'Ca-oxalate'



'intra-aqueous kinetic reactions'
1                                    ;number of intra-aqueous kinetic reactions
'oxalate_rxn'                         ;oxalate oxidation
!'oxalateO2'                         ;oxalate(aq) oxidation 


'scaling for intra-aqueous kinetic reactions'
5.40E-9                                  !from Bravo et al, 2014. Consumption rate by Streptomyces achromogenes (mol/sec)
!3.78E-8                            !input rate for Ca-ox falling from tree
                          
'done'


! Data Block 3: spatial discretization
! ---------------------------------------------------------------------------
!
'spatial discretization'
1                             ;number of discretization intervals in x
1                             ;number of control volumes in x
0.0 1.0                       ;xmin,xmax
1                             ;number of discretization intervals in y
6                             ;number of control volumes in y
0.0 5.0                       ;ymin,ymax
1                             ;number of discretization intervals in z
4                            ;number of control volumes in z
0 3.0                         ;zmin,zmax

'done'

! Data Block 4: time step control - global system
! ---------------------------------------------------------------------------
!
'time step control - global system'
'years'                        ;time unit
0.0d0                          ;time at start of solution
50.0                           ;final solution time
1.0d0                          ;maximum time step
1.0d-20                        ;minimum time step

'done'

!
! Data Block 5: control parameters - local geochemistry
! ---------------------------------------------------------------------------
!
'control parameters - local geochemistry'

'activity update settings'
'time_lagged'

'newton iteration settings'
1.E-4                         ;factor for numerical differentiation
1.E-6                         ;convergence tolerance

'define minimum reaction rate'
0.E0

'maximum ionic strength'
2.E0                         ;max. ionic strength

'minimum activity for h2o'
0.5E0                         ;min. activity for h2o

'output time unit'
'days'                       ;time unit (local chemistry)


'done'

! Data Block 6: control parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'control parameters - water flow'

'mass balance'

'input units for boundary and initial conditions'
'hydraulic head'              ;input unit

'upstream weighting'

!'compute underrelaxation factor'
!0.1                          ;max. allowed update

'newton iteration settings'
1.0d-6                        ;increment for numerical differentiation
100                           ;max. number of newton iterations
1.0d-8                        ;convergence tolerance
0.02                          ;sw_star

'solver settings'
0                             ;incomplete factorization level
500                           ;max. number of solver iterations
1                             ;solver information level
1.0d-9                        ;solver residual tolerance
1.0d-9                        ;solver update tolerance

'done'

!
! Data Block 7: control parameters - reactive transport
! ---------------------------------------------------------------------------
!

'control parameters - reactive transport'
'redox reactions'
.true.

'mass balance'

'spatial weighting'
'upstream'

'activity update settings'
'time_lagged'

'tortuosity correction'
'millington'

'gas tortuosity correction'
'millington'

'user-specified underrelaxation factor'
1.0

'newton iteration settings'
1.0d-6                        ;increment h for numerical differentiation
12                            ;anticipated number of Newton iterations
15                            ;max. number of Newton iterations
0.5                           ;anticipated update in log cycles
1.0                           ;maximum update in log cycles
1.0d-8                        ;convergence tolerance (global system)

'solver settings'
0                             ;incomplete factorization level
500                           ;max. number of solver iterations
1                             ;information level
1.0d-9                        ;solver residual tolerance
1.0d-9                        ;solver update tolerance


'done'

! Data Block 8: output control
! ---------------------------------------------------------------------------
!
'output control'

'output in terms of depth'

'output of spatial data'
5                             ;number of output times (spatial data)
10.0 20.0 30.0 40.0
50.0                          ;specified output times (spatial data)

'output of transient data'
4                             ;number of output locations (transient data)
1                             ;timesteps between output (transient data)
3 4 10 18                     ;control volume numbers for transient data

'done'

! Data Block 9: physical parameters - porous medium
! ---------------------------------------------------------------------------
!
'physical parameters - porous medium'
3                             ;number of material property zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'soil'
0.43                      ;porosity

'extent of zone'
0.0 1.0  0.0 5.0  0.0 0.5  

'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
2
'soil2'
0.43                      ;porosity

'extent of zone'
0.0 1.0  0.0 5.0  0.5 2.5  

'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
3
'soil3'
0.43                      ;porosity

'extent of zone'
0.0 1.0  0.0 5.0  2.5 3.0  

'end of zone'

'done'

! Data Block 10: physical parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'physical parameters - variably saturated flow'

! ---------------------------------------------------------------------------
'soil'

'hydraulic conductivity in z-direction'
2.89d-6                      ;K_zz

'hydraulic conductivity in y-direction'   !will need to change
1.0E-5                       ;K_yy

'specific storage coefficient'
1d-5

'soil hydraulic function parameters'
0.15                        ;residual saturation
1.20                        ;van genuchten - alpha
1.38                        ;van genuchten - n
0.5                         ;expn
0.0                         ;air entry pressure
0.0                         ;psidry (air-dry pressure head)

! ---------------------------------------------------------------------------
'soil2'

'hydraulic conductivity in z-direction'
2.89d-6                      ;K_zz

'hydraulic conductivity in y-direction'   !will need to change
1.0E-5                       ;K_yy

'specific storage coefficient'
1d-5

'soil hydraulic function parameters'
0.15                        ;residual saturation
1.20                        ;van genuchten - alpha
1.38                        ;van genuchten - n
0.5                         ;expn
0.0                         ;air entry pressure
0.0                         ;psidry (air-dry pressure head)

! ---------------------------------------------------------------------------
'soil3'

'hydraulic conductivity in z-direction'
2.89d-6                      ;K_zz

'hydraulic conductivity in y-direction'   !will need to change
1.0E-5                       ;K_yy

'specific storage coefficient'
1d-5

'soil hydraulic function parameters'
0.15                        ;residual saturation
1.20                        ;van genuchten - alpha
1.38                        ;van genuchten - n
0.5                         ;expn
0.0                         ;air entry pressure
0.0                         ;psidry (air-dry pressure head)
'done'

! Data Block 11: physical parameters - reactive transport
! ---------------------------------------------------------------------------
!
'physical parameters - reactive transport'

'diffusion coefficients'
1.0d-9                      ;free diffusion coefficient in water !reasonable estimate in this context
1.65d-5                     ;free diffusion coefficient in air !Molins and Mayer, 2007

! ---------------------------------------------------------------------------
'soil'

'longitudinal dispersivity'
0.0                         ;vertical dispersivity

'transverse vertical dispersivity' !
0.0

'end of zone'

! ---------------------------------------------------------------------------
'soil2'

'longitudinal dispersivity'
0.0                         ;vertical dispersivity

'transverse vertical dispersivity' !
0.0

'end of zone'

! ---------------------------------------------------------------------------
'soil3'

'longitudinal dispersivity'
0.0                         ;vertical dispersivity

'transverse vertical dispersivity' !
0.0

'end of zone'

'done'

