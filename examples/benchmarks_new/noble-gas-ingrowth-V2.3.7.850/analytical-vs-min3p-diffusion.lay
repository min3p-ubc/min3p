#!MC 1410
$!VarSet |LFDSFN1| = '"4He-ingrowth-diffusion-a/analytical.gst" "4He-ingrowth-diffusion-a/4He-ingrowth-diffusion_8.gst"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "4he(aq)"'
$!VarSet |LFDSFN2| = '"4He-ingrowth-diffusion-b/analytical.gst" "4He-ingrowth-diffusion-b/4He-ingrowth-diffusion_8.gst" "4He-ingrowth-diffusion-c/analytical.gst" "4He-ingrowth-diffusion-c/4He-ingrowth-diffusion_8.gst"'
$!VarSet |LFDSVL2| = '"x" "y" "z" "4he(aq)"'
$!VarSet |LFDSFN3| = '"4He-ingrowth-diffusion-c/analytical-1.0e7.gst" "4He-ingrowth-diffusion-c/4He-ingrowth-diffusion_7.gst"'
$!VarSet |LFDSVL3| = '"x" "y" "z" "4he(aq)"'
$!SetStyleBase Factory
$!GlobalPaper 
  PaperSizeInfo
    {
    Letter
      {
      Width = 8.5
      Height = 11
      LeftHardClipOffset = 0.125
      RightHardClipOffset = 0.125
      TopHardClipOffset = 0.125
      BottomHardClipOffset = 0.125
      }
    }
$!Page 
  Name = 'Untitled'
  PaperAttributes
    {
    BackgroundColor = White
    IsTransparent = Yes
    OrientPortrait = No
    ShowGrid = Yes
    ShowRuler = No
    ShowPaper = No
    PaperSize = Letter
    RulerSpacing = OneInch
    PaperGridSpacing = HalfInch
    RegionInWorkArea
      {
      X1 = 1
      Y1 = 0.25
      X2 = 10
      Y2 = 8.25
      }
    }
### Frame Number 1 ###
$!ReadDataSet  '|LFDSFN1|'
  InitialPlotType = XYLine
  IncludeText = No
  IncludeGeom = No
  ResetStyle = No
  AssignStrandIDs = Yes
  VarLoadMode = ByName
  VarNameList = '|LFDSVL1|'
$!RemoveVar |LFDSVL1|
$!RemoveVar |LFDSFN1|
$!ReadDataSet  '|LFDSFN2|'
  InitialPlotType = XYLine
  IncludeText = No
  IncludeGeom = No
  ReadDataOption = Append
  ResetStyle = No
  AssignStrandIDs = Yes
  VarLoadMode = ByName
  VarNameList = '|LFDSVL2|'
$!RemoveVar |LFDSVL2|
$!RemoveVar |LFDSFN2|
$!ReadDataSet  '|LFDSFN3|'
  InitialPlotType = XYLine
  IncludeText = No
  IncludeGeom = No
  ReadDataOption = Append
  ResetStyle = No
  AssignStrandIDs = Yes
  VarLoadMode = ByName
  VarNameList = '|LFDSVL3|'
$!RemoveVar |LFDSVL3|
$!RemoveVar |LFDSFN3|
$!FrameLayout 
  ShowHeader = No
  HeaderColor = Red
  XYPos
    {
    X = 1
    Y = 0.25
    }
  Width = 6
  Height = 9
$!ThreeDAxis 
  AspectRatioLimit = 25
  BoxAspectRatioLimit = 25
$!PlotType  = XYLine
$!FrameName  = 'Frame 001'
$!GlobalTime 
  SolutionTime = 0
$!DeleteLineMaps 
$!ActiveLineMaps  =  [1-8]
$!GlobalLinePlot 
  DataLabels
    {
    DistanceSkip = 5
    }
  Legend
    {
    Show = Yes
    TextShape
      {
      SizeUnits = Point
      Height = 14
      }
    Box
      {
      BoxType = None
      }
    RowSpacing = 1
    XYPos
      {
      X = 91.703
      Y = 99.837
      }
    }
$!LineMap  [1]
  Name = 'S1 - Analytical, D 1.0e-7, T 1.0e8 '
