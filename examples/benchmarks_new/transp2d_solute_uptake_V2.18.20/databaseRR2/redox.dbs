! -------------------------------------------------------------------------------------------
! MIN3P database entries for oxidation-reduction reactions defined by Uli Maier for SAFIRA II
!  irreversible reactions, Monod
!
!  ammonium oxidation to nitrate - Monod-kinetics
!
'nitrificat.'
5  'nh4+1' -1.000  'o2(aq)' -2.000  'h2o' 1.000  'no3-1' 1.000  'h+1' 2.000
'irreversible'                   ! type of reaction

'hyperbolic T^a'  4              ! monod and threshold terms
'o2(aq)' 1.d-4    1.0d0
'nh4+1'  1.d-5    1.0d0
'o2(aq)' 1.d-5    2.0d0
'nh4+1'  1.d-10   2.0d0
                                 ! no inhibition and toxicity terms...
! -------------------------------------------------------------------------------------------
! nitrification of ammonium, neglecting reaction products to save RAM
!  irreversible reactions, Monod
!
!  ammonium oxidation to nitrate - Monod-kinetics
!
'nitrif_ohne'
3  'nh4+1' -1.000  'o2(aq)' -2.000  'h2o' 1.000             'no3-1' 1.000  'h+1' 2.000
'irreversible'                   ! type of reaction

'hyperbolic T^a'  4              ! monod and threshold terms
'o2(aq)' 1.d-4    1.0d0
'nh4+1'  1.d-5    1.0d0
'o2(aq)' 1.d-5    2.0d0
'nh4+1'  1.d-6    2.0d0
                                 ! no inhibition and toxicity terms...
!
! ---------------------------------------------------------------------
!  irreversible reactions, pseudo first order
!  ammonium oxidation to nitrate - first-order-kinetics
!
'nitri-1st'
5  'nh4+1' -1.000  'o2(aq)' -2.000  'h2o' 1.000  'no3-1' 1.000  'h+1' 2.000
'irreversible'                   ! type of reaction

'fractional T^a'  1              ! fractional order terms
'nh4+1'  1.0d0

'hyperbolic T^a'  2              ! monod and threshold terms
'o2(aq)' 1.d-5    1.0d0
'o2(aq)' 1.d-7    2.0d0

'activation energy' 12.37        ! just a housenumber 

!-------------- nh4+1 ------------------------------------
!  Anammox reaction to N2 - Monod-kinetics, irreversible reaction, inhibited by O2 (Fe+2??)
!
'Anammox-1'
5  'nh4+1' -1.000    'no3-1' -0.600    'n2(aq)' 0.800    'h2o' 1.800    'h+1' 0.400
'irreversible'

'fractional T^a'  1
'nh4+1'  1.0

'hyperbolic T^a'  2
'no3-1'  1.d-6    1.0d0
'no3-1'  1.d-8    2.0d0

'inhibition T^a'  1              ! 'fe+2'    1.d-6   1.0
'o2(aq)'  1.d-6   1.0

! -------------------------------------------------------
!  benzene degradation by iron reduction - Monod-kinetics
!
'benz-fe'
6    'c6h6'    -1.000    'h2o'  -18.000    'fe+3'   -30.000    'co3-2'   6.000   'fe+2'  30.000    'h+1'   42.000
'irreversible'

'fractional T^a'  1
'c6h6'  1.0d0

'hyperbolic T^a'  2              ; changed from: 1.d-24 & 1.d-26 (27.10.2006)
'fe+3'  1.d-22    1.0d0
'fe+3'  1.d-23    2.0d0

'inhibition T^a'  1              ! hier Absturz, Syntax-Error: order/exponent (1.0) has to be provided!
'o2(aq)'  1.d-5   1.0

'activation energy' 12.37        ! just a housenumber 

! ------------------------------------------------------
!  benzene degradation by sulfate reduction - Monod-kinetics
!
'benz-so4'
6    'c6h6'    -1.000    'h2o'   -3.000    'so4-2'   -3.750    'co3-2'   6.000   'hs-1'   3.750    'h+1'   8.250
'irreversible'

'fractional T^a'  1
'c6h6'  1.0d0

'hyperbolic T^a'  2
'so4-2'  1.d-6    1.0d0
'so4-2'  1.d-8    2.0d0

'inhibition T^a'  1
'o2(aq)'  1.d-6   1.0

'inhibition phi^m'  1
'ferrihydrit'     1.00d-06   1.0
'ferrihydrite'    1.00d-06   1.0
'lepidocrocit'    1.00d-06   1.0
'goethite'        1.00d-06   1.0
'hematite'        1.00d-06   1.0

'activation energy' 12.37

! activation energy just a housenumber 
! inhibition and toxicity terms (mineral phase) doesn't work so far: component for intra-aqueous kinetic reaction decan-so4 is missing (even though it's there)
! exact number must be provided, but unused minerals can be left after the used ones

! ------------------------------------------------------
!  decane degradation by sulfate reduction - Monod-kinetics
!
'decan-so4'
6    'decan'   -1.000    'h2o'    1.000    'so4-2'   -7.750    'co3-2'   10.000         'hs-1'   7.750    'h+1'   12.250
'irreversible'

'fractional T^a'  1
'decan'  1.0d0

'hyperbolic T^a'  2              !monod and threshold terms
'so4-2'  1.d-6    1.0d0
'so4-2'  1.d-8    2.0d0

'inhibition T^a'  1              !inhibition and toxicity terms (aqueous phase)
'o2(aq)'  1.d-6   1.0

'inhibition phi^m'  1            !inhibition and toxicity terms (mineral phase) doesn't work so far: component for intra-aqueous kinetic reaction decan-so4 is missing (even though it's there)
'ferrihydrit'     1.00d-06   1.0
'ferrihydrite'    1.00d-06   1.0
'lepidocrocit'    1.00d-06   1.0
'goethite'        1.00d-06   1.0
'hematite'        1.00d-06   1.0    ! exact number must be provided, no unused minerals!

'activation energy' 12.37        ! just a housenumber 

!-------------- fe+2 -----------------------------------
! fe+2 - kinetic oxidation
!
'fe+2-ox'
5  'fe+2' -1.000  'o2(aq)' -0.250  'h+1' -1.000  'fe+3' 1.000  'h2o' 0.500
'irreversible'

'fractional T^a'  1
'fe+2'   1.0

'hyperbolic T^a'  2
'o2(aq)' 1.d-4    1.0d0
'o2(aq)' 1.d-6    2.0d0

'activation energy' 12.37        ! just a housenumber 

