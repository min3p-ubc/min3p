    {
    CONSTRAINT 1
      {
      VARA = 1
      }
    }
$!LINEMAP  [1]
  NAME = 'S_g_t' 
  ASSIGN
    {
    ZONE = 3
    XAXISVAR = 1
    YAXISVAR = 15
