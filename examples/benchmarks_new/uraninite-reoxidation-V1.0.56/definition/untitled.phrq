-tol 1e-10

SELECTED_OUTPUT
-file Combine.dat
-totals Fe(3) Feii U(4) Uranyl S Sulfate Lac Acetate C
-saturation_indices Hematite Uraninite Siderite Calcite Schoepite UO2(OH)2b
-equilibrium_phases hematite uraninite
USER_PUNCH
-heading pe_Fe3 rate1 biom1 rate2 biom2 rate_r aff_r rate_f aff_f rate_u aff_u S_lqk S_aff S_rate S_moles
-start
#10 pe_O2=-(-85.9951-4.*LA("H+")-LA("Oxy"))/4.
#20 pe_N5= 21.449-0.1*LA("Naq")+0.2*LA("NO3-")+1.2*LA("H+")
30 pe_Fe3=-(-13.032-LA("Fe+3")+LA("Feii+2"))
#40 pe_S6=-(-33.66+LA("HS-")-9.*LA("H+")-LA("Sulfate-2"))/8.
40 logQKr = get(30)
50 logQKf = get(40)
70 logQKu = get(10)
80 affr = get(31)
90 afff = get(41)
100 affu = get(11)
110 rate1 = get(1)
120 rate2 = get(2)
122 biom1 = get(3)
124 biom2 = get(4)
130 rate_r = get(32)
140 rate_f = get(42)
150 rate_u = get(12)
151 S_lqk  = get(50)
152 S_aff  = get(55)
153 S_rate = get(56)
154 S_moles = get(57)
160 PUNCH pe_Fe3, rate1, biom1, rate2, biom2, rate_r affr rate_f afff rate_u affu S_lqk S_aff S_rate KIN("Sulfur_s")
-end
USER_GRAPH
-heading Time Lac- Acetate- Sulfate HS- Biomass U(6) U(4) Feii
-chart_title "Uranium Reduction"
-axis_titles "Days" "Concentration (mM)" "U(VI) and Fe conc.(uM)"
-axis_scale x_axis 0 40 10
-axis_scale y_axis 0 50 10
-axis_scale sy_axis 0 100
-plot_concentration_vs t
-initial_solutions false
-start
10 GRAPH_X total_time/86400
20 GRAPH_Y 1e3*mol("Lac-"),1e3*mol("Acetate-"),1e3*mol("Sulfate-2"),1e3*mol("HS-"), Kin("Biomass")
30 GRAPH_sy 1e6*tot("Uranyl"), 1e6*tot("U(4)"), 1e6*tot("Feii")
-end
END









