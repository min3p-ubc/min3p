	SELECTED_OUTPUT
	    file  ionx.out
	    reset      true
	USER_PUNCH
	headings Ca Cl Na K CaX2 NaX KX  
	10 PUNCH TOT("Ca"), TOT("Cl"), TOT("Na"), TOT("K")
	20 ca_x2 = MOL("CaX2")*100/1.875*0.3*2
	30 na_x = MOL("NaX")*100/1.875*0.3
	40 k_x = MOL("KX")*100/1.875*0.3
	50 PUNCH ca_x2 na_x k_x
	END
