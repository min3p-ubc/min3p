$!XYLINEAXIS 
  DEPXTOYRATIO = 1
$!XYLINEAXIS 
  XDETAIL 1
    {
    RANGEMIN = 0.01
    RANGEMAX = 1
    GRSPACING = 0.2
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 2
        }
      }
    TITLE
      {
      TEXTSHAPE
        {
        HEIGHT = 2.6
        }
      }
    }
$!XYLINEAXIS 
  XDETAIL 2
    {
    SHOWAXIS = NO
    RANGEMIN = 1
    RANGEMAX = 100
    GRSPACING = 20
    AXISLINE
      {
      AXISALIGNMENT = WITHGRIDMAX
      }
    }
$!XYLINEAXIS 
  YDETAIL 1
    {
    RANGEMIN = -0.00015000000000000007
    RANGEMAX = 0.00019999999999999966
    GRSPACING = 5E-005
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 2
        }
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'C[mol/L]' 
      TEXTSHAPE
        {
        HEIGHT = 2.6
        }
      OFFSET = 8
      }
    }
$!XYLINEAXIS 
  YDETAIL 2
    {
    RANGEMIN = -0.01
    RANGEMAX = 0.01
    GRSPACING = 0.005
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 2
        }
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'Charge Imbalance [%]' 
      TEXTSHAPE
        {
        HEIGHT = 2.6
        }
      }
    AXISLINE
      {
      AXISALIGNMENT = WITHGRIDMAX
      }
    }
$!LINEPLOTLAYERS 
  SHOWSYMBOLS = YES
$!SETSTYLEBASE CONFIG
