!

! This is a 1D batch reaction at 5 degC to verify temperature effect on gas exchange defined in   

!  the database gas.dbs against PHREEQC.

! 

! Data Block 1: global control parameters

! ---------------------------------------------------------------------------

!

'global control parameters'

'gas temperature - batch problem'

.false.                       ;varsat_flow

.false.                       ;steady_flow

.false.                       ;fully_saturated

.false.                       ;reactive_transport



'energy balance'



'done'



! Data Block 2: geochemical system

! ---------------------------------------------------------------------------

!

'geochemical system'



!'use pitzer model'



!'use macinnes convention' 



'use new database format'



'database directory'

'.\database\default'



'define input units'

'mol/l'



'define temperature'

5.0 



'components'

4   ;10                            ;number of components (nc-1)

'h+1'

'o2(aq)'

'na+1'

'cl-1'





'secondary aqueous species'

2                              ;number of secondary aqueous species

'h2(aq)'

'oh-'







!'intra-aqueous kinetic reactions'

!1                             ;number of intra-aqueous kinetic reactions

!'ch2o-so4'



'minerals'

0				;number of minerals (nm)

!'ch2o-h2s'

'calcite'

!'anhydrite'

!'halite'



'excluded minerals'

0





'gases'

1					;number of gases

'o2(g)'					;names of gases

'h2(g)'





'done'







! Data Block 5: control parameters - local geochemistry

! ---------------------------------------------------------------------------

!

'control parameters - local geochemistry'



'activity update settings'

'no_update'

!'double_update'



'newton iteration settings'

1.d-4                         ;factor for num. differentiation

1.d-6                         ;convergence tolerance



'maximum ionic strength'

0.5d0    !4.d0                          ;max. ionic stength



'minimum activity for h2o'

0.5d0                         ;min. activity for h2o



'output time unit'

'years'                       ;time unit (local chemistry)



'done'









! Data Block 14: initial condition - reactive transport

! ---------------------------------------------------------------------------

!

'initial condition - local geochemistry'

1                             ;number of zones



! ---------------------------------------------------------------------------

'number and name of zone'

1

'background chemistry - aquifer'



'concentration input'                

7.0	'ph'	'h+1'

1.0e-003	'free'	'o2(aq)'

1.0e-005	'free'	'na+1'

1.0e-005	'free'	'cl-1'



'end of zone'



'done'





