$!XYLineAxis 
  DepXToYRatio = 1
$!XYLineAxis 
  XDetail 1
    {
    CoordScale = Log
    RangeMin = 1.00000001335143196E-10
    RangeMax = 4.000399999999990186
    GRSpacing = 0.5
    }
$!XYLineAxis 
  YDetail 1
    {
    RangeMin = 1.575010060150816571E-07
    RangeMax = 6.433125013907894818
    GRSpacing = 0.5
    }
$!FrameControl ActivateByNumber
  Frame = 1
$!SetStyleBase Config
