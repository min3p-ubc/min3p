'define input units'

'mol/l'



'define temperature'

60.0 



'components'

3                             ;number of components (nc-1)

'ca+2'

'h+1'

'co3-2'



'secondary aqueous species'

6                              ;number of secondary aqueous species

'oh-'

'caoh+'

'cahco3+'

'caco3aq'

'hco3-'

'h2co3aq'



!'intra-aqueous kinetic reactions'

!1                             ;number of intra-aqueous kinetic reactions

!'ch2o-so4'



