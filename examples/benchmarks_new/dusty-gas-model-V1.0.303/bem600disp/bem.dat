! Data Block 11: physical parameters - reactive transport
! ---------------------------------------------------------------------------
!
'physical parameters - reactive transport'

'diffusion coefficients'
0.0d+0                         ;aqueous phase
1.8d-5                         ;gaseous phase

'dusty gas model'
2.263d-5                       ;o2-ch4
1.635d-5                       ;o2-co2
1.928d-5                       ;o2-ar
2.083d-5                       ;o2-n2
1.705d-5                       ;ch4-co2
2.045d-5                       ;ch4-ar
2.137d-5                       ;ch4-n2
1.525d-5                       ;co2-ar
1.649d-5                       ;co2-n2
1.954d-5                       ;ar-n2
2.04d-5                        ;o2
1.09d-5                        ;ch4
1.46d-5                        ;co2x
2.22d-5                        ;ar
1.75d-5                        ;n2

'update density'

'wilke viscosity'
2.04d-5                        ;o2
1.09d-5                        ;ch4
1.46d-5                        ;co2x
2.22d-5                        ;ar
1.75d-5                        ;n2

! ---------------------------------------------------------------------------
'lower VZ'

'longitudinal dispersivity'
0.1d0

'end of zone'

'confining unit'

'longitudinal dispersivity'
0.1d0

'end of zone'

'upper VZ'

'longitudinal dispersivity'
0.1d0

'end of zone'

'done'
