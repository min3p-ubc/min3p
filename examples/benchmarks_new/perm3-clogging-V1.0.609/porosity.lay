#!MC 1000
$!VarSet |LFDSFN1| = '"perm3_10.gsv" "perm3_11.gsv" "perm3_12.gsv" "perm3_6.gsv" "perm3_7.gsv" "perm3_8.gsv" "perm3_9.gsv"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "calcite" "gypsum" "ferrihydrite" "jarositek" "gibbsite(c)" "siderite(d)" "porosity" "hydraulic conductivity kx" "hydraulic conductivity ky" "hydraulic conductivity kz"'
$!VarSet |LFDSFN2| = '"perm3_16.gsv"'
$!VarSet |LFDSVL2| = '"x" "y" "z" "calcite" "gypsum" "ferrihydrite" "jarositek" "gibbsite(c)" "siderite(d)" "porosity" "hydraulic conductivity kx" "hydraulic conductivity ky" "hydraulic conductivity kz"'
$!VarSet |LFDSFN3| = '"perm3_14.gsv"'
