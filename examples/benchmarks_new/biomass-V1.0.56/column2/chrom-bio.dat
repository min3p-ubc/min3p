'c5h7o2n'                     ;biomass component names

'c5h7o2n(d)'



'secondary aqueous species'

20                            ;number of secondary aqueous species

'oh-'                         ;names of secondary aqueous species

'h2co3aq'

'hco3-'

'caoh+'

'caco3aq'

