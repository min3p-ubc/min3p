$!XYLINEAXIS 
  DEPXTOYRATIO = 1
$!XYLINEAXIS 
  XDETAIL 1
    {
    RANGEMIN = 0
    RANGEMAX = 0.010000999776460231
    GRSPACING = 0.002
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 2
        }
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'Distance [m]' 
      TEXTSHAPE
        {
        HEIGHT = 2.6
        }
      }
    }
$!XYLINEAXIS 
  XDETAIL 2
    {
    SHOWAXIS = NO
    RANGEMIN = 0
    RANGEMAX = 1
    GRSPACING = 0.2
    AXISLINE
      {
      AXISALIGNMENT = WITHGRIDMAX
      }
    }
$!XYLINEAXIS 
  YDETAIL 1
    {
    RANGEMIN = 0
    RANGEMAX = 0.00012999999999999999
    GRSPACING = 2E-005
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 2
        }
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'Concetration [mol/L]' 
      TEXTSHAPE
        {
        HEIGHT = 2.6
        }
      OFFSET = 7
      }
    }
$!XYLINEAXIS 
  YDETAIL 2
    {
    RANGEMIN = -1
    RANGEMAX = 0.99999999999999778
    GRSPACING = 0.2
    TICKLABEL
      {
      TEXTSHAPE
        {
        HEIGHT = 2
        }
      }
    TITLE
      {
      TITLEMODE = USETEXT
      TEXT = 'CBE [%]' 
      TEXTSHAPE
        {
        HEIGHT = 2.6
        }
      }
    AXISLINE
      {
      AXISALIGNMENT = WITHGRIDMAX
      }
    }
$!LINEPLOTLAYERS 
  SHOWSYMBOLS = YES
$!SETSTYLEBASE CONFIG
