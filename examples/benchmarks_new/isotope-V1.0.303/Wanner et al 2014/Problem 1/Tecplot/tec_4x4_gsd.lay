#!MC 1000
$!VarSet |LFDSFN1| = '"..\Cr_1.gsd"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "cr(oh)3(a)_1" "co2(s)_1" "chamosite_1" "quartz_1" "annite_1"'
$!VarSet |LFDSFN2| = '"..\Cr_2.gsd"'
$!VarSet |LFDSVL2| = '"x" "y" "z" "cr(oh)3(a)_1" "co2(s)_1" "chamosite_1" "quartz_1" "annite_1"'
