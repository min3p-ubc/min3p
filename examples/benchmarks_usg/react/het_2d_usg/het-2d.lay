#!MC 700
$!VarSet |LFDSFN1| = 'het-2d.gsm'
$!VarSet |LFDSFN2| = 'het-2d.gsv'
$!VarSet |LFDSFN3| = 'het-2d_1.gsm'
$!VarSet |LFDSFN4| = 'het-2d_1.gsv'
$!SETSTYLEBASE FACTORY
$!PAPER 
  BACKGROUNDCOLOR = WHITE
  ISTRANSPARENT = YES
  ORIENTPORTRAIT = NO
  SHOWPAPER = YES
  PAPERSIZE = LETTER
  PAPERSIZEINFO
    {
    LETTER
      {
      WIDTH = 8.5
      HEIGHT = 11
      LEFTHARDCLIPOFFSET = 0.125
      RIGHTHARDCLIPOFFSET = 0.125
      TOPHARDCLIPOFFSET = 0.125
      BOTTOMHARDCLIPOFFSET = 0.125
      }
    }
  REGIONINWORKAREA
    {
    X1 = -0.05
    Y1 = -0.05
    X2 = 11.05
    Y2 = 8.55
    }
$!PRINTSETUP 
  MONOFLOODMAP
    {
    BLACKSHADE = 100
    }
$!COLORSPECTRUM 
  CONTOURCOLORMAP = GRAYSCALE
  SURFACERGBMIN
    {
    R = 0
    G = 0
    B = 0
    }
  SURFACERGBMAX
    {
    R = 255
    G = 255
    B = 255
    }
$!COLORMAPCONTROL RESETTOFACTORY
$!COLORSPECTRUM 
  GRAYSCALE
    {
    CONTROLPOINT 2
      {
      COLORMAPFRACTION = 0.04746
      }
    CONTROLPOINT 3
      {
      COLORMAPFRACTION = 0.09493
      }
    CONTROLPOINT 4
      {
      COLORMAPFRACTION = 0.1687
      }
    CONTROLPOINT 5
      {
      COLORMAPFRACTION = 0.2493
      }
    CONTROLPOINT 6
      {
      COLORMAPFRACTION = 0.4979
      }
    CONTROLPOINT 7
      {
      COLORMAPFRACTION = 0.6652
      }
    CONTROLPOINT 8
      {
      COLORMAPFRACTION = 0.8326
      }
    }
### Frame Number 1 ###
