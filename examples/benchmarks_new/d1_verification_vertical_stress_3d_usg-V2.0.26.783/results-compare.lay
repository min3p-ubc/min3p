#!MC 1410
$!VarSet |LFDSFN1| = '"basin-fh-w-3d-usg.dat"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "fh_w_100" "fh_w_500" "fh_w_1000" "fh_w_5000" "fh_w_10000" "fh_w_20000"'
$!VarSet |LFDSFN2| = '"1d_solution/basin-1.gsp"'
$!VarSet |LFDSVL2| = '"x" "y" "z" "fh_w_100" "fh_w_500" "fh_w_1000" "fh_w_5000" "fh_w_10000" "fh_w_20000" "fh_w"'
$!VarSet |LFDSFN3| = '"1d_solution/basin-2.gsp" "1d_solution/basin-3.gsp" "1d_solution/basin-4.gsp" "1d_solution/basin-5.gsp" "1d_solution/basin-6.gsp"'
$!VarSet |LFDSVL3| = '"x" "y" "z" "fh_w_100" "fh_w_500" "fh_w_1000" "fh_w_5000" "fh_w_10000" "fh_w_20000" "fh_w"'
$!SetStyleBase Factory
$!GlobalPaper 
  PaperSizeInfo
    {
    Letter
      {
      Width = 8.5
      Height = 11
      LeftHardClipOffset = 0.125
      RightHardClipOffset = 0.125
      TopHardClipOffset = 0.125
      BottomHardClipOffset = 0.125
      }
    }
$!Page 
  Name = 'Untitled'
  PaperAttributes
    {
    BackgroundColor = White
    IsTransparent = Yes
    OrientPortrait = No
    ShowGrid = Yes
    ShowRuler = No
    ShowPaper = No
    PaperSize = Letter
    RulerSpacing = OneInch
    PaperGridSpacing = HalfInch
    RegionInWorkArea
      {
      X1 = 1
      Y1 = 0.25
      X2 = 10
      Y2 = 8.25
      }
    }
### Frame Number 1 ###
$!ReadDataSet  '|LFDSFN1|'
  InitialPlotType = XYLine
  IncludeText = No
  IncludeGeom = No
  ResetStyle = No
  AssignStrandIDs = Yes
  VarLoadMode = ByName
  VarNameList = '|LFDSVL1|'
$!RemoveVar |LFDSVL1|
$!RemoveVar |LFDSFN1|
$!ReadDataSet  '|LFDSFN2|'
  InitialPlotType = XYLine
  IncludeText = No
  IncludeGeom = No
  ReadDataOption = Append
  ResetStyle = No
  AssignStrandIDs = Yes
  VarLoadMode = ByName
  VarNameList = '|LFDSVL2|'
$!RemoveVar |LFDSVL2|
$!RemoveVar |LFDSFN2|
$!ReadDataSet  '|LFDSFN3|'
  InitialPlotType = XYLine
  IncludeText = No
  IncludeGeom = No
  ReadDataOption = Append
  ResetStyle = No
  AssignStrandIDs = Yes
  VarLoadMode = ByName
  VarNameList = '|LFDSVL3|'
$!RemoveVar |LFDSVL3|
$!RemoveVar |LFDSFN3|
$!FrameLayout 
  ShowHeader = No
  HeaderColor = Red
  XYPos
    {
    X = 1
    Y = 0.25
    }
  Width = 9
  Height = 8
$!ThreeDAxis 
  AspectRatioLimit = 25
  BoxAspectRatioLimit = 25
$!PlotType  = XYLine
$!FrameName  = 'Frame 001'
$!GlobalTime 
  SolutionTime = 0
$!DeleteLineMaps 
$!ActiveLineMaps  =  [1-12]
$!GlobalLinePlot 
  DataLabels
    {
    DistanceSkip = 5
    }
  Legend
    {
    Show = Yes
    TextShape
      {
      Height = 2
      }
    Box
      {
      BoxType = None
      }
    XYPos
      {
      X = 85.467
      Y = 91.09
      }
    }
$!LineMap  [1]
  Name = '3d usg 100 years'
  Assign
    {
    Zone = 1
    XAxisVar = 4
    YAxisVar = 3
    }
  Lines
    {
    Color = Red
    }
  Symbols
    {
    Show = No
    Color = Red
    FillColor = Red
    Size = 0.5
    Skipping = 4
    }
  BarCharts
    {
    Color = Red
    FillColor = Red
    }
  ErrorBars
