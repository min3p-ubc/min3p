#!MC 900
$!VarSet |LFDSFN1| = '"bem_1.gsk"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "grad_adv_x" "grad_adv_y" "grad_adv_z" "o2(g)_diff_x" "ch4(g)_diff_x" "co2x(g)_diff_x" "ar(g)_diff_x" "n2(g)_diff_x" "o2(g)_diff_y" "ch4(g)_diff_y" "co2x(g)_diff_y" "ar(g)_diff_y" "n2(g)_diff_y" "o2(g)_diff_z" "ch4(g)_diff_z" "co2x(g)_diff_z" "ar(g)_diff_z" "n2(g)_diff_z"'
$!SETSTYLEBASE FACTORY
$!PAPER 
  BACKGROUNDCOLOR = WHITE
  ISTRANSPARENT = YES
  ORIENTPORTRAIT = NO
  SHOWGRID = YES
  SHOWRULER = YES
  SHOWPAPER = YES
  PAPERSIZE = LETTER
  PAPERSIZEINFO
    {
    LETTER
      {
      WIDTH = 8.5
      HEIGHT = 11
      LEFTHARDCLIPOFFSET = 0.125
      RIGHTHARDCLIPOFFSET = 0.125
      TOPHARDCLIPOFFSET = 0.125
      BOTTOMHARDCLIPOFFSET = 0.125
      }
    }
  RULERSPACING = ONEINCH
  PAPERGRIDSPACING = HALFINCH
  REGIONINWORKAREA
    {
    X1 = -0.05
    Y1 = -0.05
    X2 = 11.05
    Y2 = 8.55
    }
$!COLORMAP 
  CONTOURCOLORMAP = SMRAINBOW
$!COLORMAPCONTROL RESETTOFACTORY
### Frame Number 1 ###
