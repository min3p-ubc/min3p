DATABASE C:\Program Files (x86)\USGS\Phreeqc Interactive 3.0.0-7430\database\phreeqc.dat
TITLE Example Surfx2 -- Transport with surface complexation reactions 

SOLUTION 1-200
    temp      25
    pH        8
    pe        12
    redox     pe
    units     mol/l
    density   1
    S(6)      1e-005  charge
    Zn        1e-007
#    Fe(2)     1e-005
    Pb     1e-007
    Ca        1e-010
    Mg        1e-005
    K         1e-005
    Na        0.001
    -water    1 # kg

SURFACE 1-200
    Hfo_sOH 0.01   10     100
    -no_edl
    -equilibrate 1

END
SOLUTION 0 #boundary
    temp      25
    pH        3
    units     mol/l
    S(6)      0.0025  charge
    Zn        0.001
#    Fe(2)     1e-005
    Pb        0.001
    Ca        1e-03
    Mg        1e-10
    K         1e-10
    Na        1e-10
end

TRANSPORT
    -cells                 200
    -shifts                3200
    -time_step             228.57 # seconds
    -flow_direction        forward
    -boundary_conditions   flux flux
    -lengths               200*0.08
    -dispersivities        200*0.01
    -diffusion_coefficient 1e-009
    -print_cells           200
    -print_frequency       200
    -punch_cells           200
    -punch_frequency       3
    -warnings              true
PRINT
    -echo_input            false
    -eh                    false
    -equilibrium_phases    false
    -exchange              false
    -gas_phase             false
    -headings              false
    -inverse               false
    -kinetics              false
    -other                 false
    -saturation_indices    false
    -solid_solutions       false
    -species               false
    -surface               false
    -totals                false
    -user_print            false
    -warnings              0
SELECTED_OUTPUT
        -file   surfx2.sel
        -reset  false 
#       -time       true
#	  -ph
USER_PUNCH
        -head time(h) S_mol Pb_mol Zn_mol Ca_mol Mg_mol K_mol Na_mol Hfo_sOH   Hfo_sOH2+    Hfo_sO-    Hfo_sOZn+   Hfo_sOPb+  Hfo_sOHCa+2  PH
10 PUNCH TOTAL_TIME/3600, TOT("S(6)"), TOT("Pb"), TOT("Zn"), TOT("Ca"), TOT("Mg"), TOT("K"), TOT("Na"), MOL("Hfo_sOH"),MOL("Hfo_sOH2+"),MOL("Hfo_sO-"),MOL("Hfo_sOZn+"),MOL("Hfo_sOPb+"),MOL("Hfo_sOHCa+2"),-LA("H+")
END
