#!MC 1000
$!VarSet |LFDSFN1| = '"hMCD_1.gbt"'
$!VarSet |LFDSVL1| = '"time" "cs+1" "na+1" "k+1" "mg+2" "ca+2" "sr+2" "cl-1" "h+1" "o2(aq)" "so4-2" "co3-2" "i-1" "br-1" "hto" "co_60+2"'
