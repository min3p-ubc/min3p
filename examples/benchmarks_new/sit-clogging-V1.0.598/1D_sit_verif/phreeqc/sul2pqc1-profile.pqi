END


TRANSPORT
    -cells                 200
    -shifts                480
    -time_step             228.57    #457.14 # seconds
    -flow_direction        forward
    -boundary_conditions   constant flux
    -lengths               200*0.08
    -dispersivities        200*0.01
    -correct_disp 	   true
    -diffusion_coefficient 1e-09
#    -print_cells           1-200
#    -print_frequency       100
    -punch_cells           1-200
    -punch_frequency       16
    -warnings              true
PRINT
    -echo_input            false
    -eh                    true
    -equilibrium_phases    false
    -exchange              false
    -gas_phase             false
    -headings              false
    -inverse               false
    -kinetics              false
    -other                 false
    -saturation_indices    false
    -solid_solutions       false
    -species               false
    -surface               false
    -totals                false
    -user_print            false
