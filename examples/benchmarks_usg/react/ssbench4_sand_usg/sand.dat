! Case1: Conservative mass transport

!

! Example for 2D mineral dissolution resulting in porosity and

! permeability enhancement

!

! Data Block 1: global control parameters

! ---------------------------------------------------------------------------

!

'global control parameters'

'Conservative mass transport'

.true.                        ;varsat_flow

.false.                        ;steady_flow

.true.                        ;fully_saturated

.true.                        ;reactive_transport



'done'



! Data Block 2: geochemical system

! ---------------------------------------------------------------------------

!

'geochemical system'



'use new database format'



'database directory'

'database\default'



'components'

1                             ;number of components (nc-1)

'dye'                         ;component names





'secondary aqueous species'

0                            ;number of secondary aqueous species

'oh-'                         ;names of secondary aqueous species

'h2so4(aq)'

'caoh+'

'cahco3+'

'caco3aq'

'caso4aq'

'cahso4+'

'hco3-'

'h2co3aq'

'hso4-'



'minerals'

0                             ;number of minerals (nm)

'calcite'                     ;mineral names



'excluded minerals'

0                             ;number of excluded minerals (nmx)

'aragonite'                   ;mineral names

'lime'

'portlandite'



'done'



! Data Block 3: spatial discretization

! ---------------------------------------------------------------------------

!

'spatial discretization'



!'generate unstructured grid from structured parameters'

!'generate unstructured grid from structured boundary'

!'generate unstructured grid from file'



'read unstructured grid from file'



'control volume method'

'voronoi diagram'

!'median dual'



'allow obtuse cells'



'structured spatial discretization'



1                             ;number of discretization intervals in x

101                           ;number of control volumes in x

0. 0.10                       ;xmin,xmax

1                             ;number of discretization intervals in y

1                             ;number of control volumes in y

0. 1.0                        ;ymin,ymax

1                             ;number of discretization intervals in z

92                            ;number of control volumes in z

0. 0.10                       ;zmin,zmax



'done'





! Data Block 4: time step control - global system

! ---------------------------------------------------------------------------

!

'time step control - global system'

'hours'                       ;time unit

0.00                          ;time at start of solution

24.0d0                        ;final solution time

0.01                          ;max. time step

1e-10                         ;min. time step



'done'



! Data Block 5: control parameters - local geochemistry

! ---------------------------------------------------------------------------

!

'control parameters - local geochemistry'



'newton iteration settings'

1.d-4                         ;factor for numerical differentiation

1.d-6                         ;convergence tolerance



'maximum ionic strength'

1.0d0                         ;max. ionic strength



'minimum activity for h2o'

0.5d0                         ;min. activity for h2o



'output time unit'

'days'                        ;time unit (local chemistry)



'done'



! Data Block 6: control parameters - variably saturated flow

! ---------------------------------------------------------------------------

!

'control parameters - variably saturated flow'



'mass balance'



'input units for boundary and initial conditions'

'hydraulic head'              ;input unit



'newton iteration settings'

1.0d-4                        ;increment for numerical differentiation

10                            ;maxit_vs, max. number of newton iterations

1.0d-6                        ;tol_vs, convergence tolerance

0.1                           ;sw_star



'solver settings'

0                             ;level_vs, incomplete factorization level

500                           ;msolvit_vs, max. number of solver iterations

2                             ;idetail_vs, solver information level

1.0d-9                        ;restol_vs, solver residual tolerance

1.0d-9                        ;deltol_vs, solver update tolerance



'done'



! Data Block 7: control parameters - reactive transport

! ---------------------------------------------------------------------------

!

'control parameters - reactive transport'



'mass balance'



'spatial weighting'

!'van leer' 

'upstream'                    ;spatial weighting



'activity update settings'

'time_lagged'                 ;type of activity update



'update porosity'



'update permeability'



!'tortuosity correction'

!'millington'



'newton iteration settings'

1.d-4                         ;increment h for numerical differentiation

12                            ;anticipted number of Newton iterations

20                            ;max. number of Newton iterations

0.5d0                         ;anticipated update in log cycles

1.0d0                         ;maximum update in log cycles

1.d-6                         ;convergence tolerance (global system)



'solver settings'

0                             ;incomplete factorization level

500                           ;max. number of solver iterations

2                             ;solver information level

1.d-9                         ;solver residual tolerance

1.d-9                         ;solver update tolerance



'done'



