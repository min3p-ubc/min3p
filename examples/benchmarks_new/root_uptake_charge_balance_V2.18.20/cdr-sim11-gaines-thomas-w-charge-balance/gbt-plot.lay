$!XYLineAxis 
  DepXToYRatio = 1
$!XYLineAxis 
  XDetail 1
    {
    RangeMin = 0
    RangeMax = 4.0003999999999999559
    GRSpacing = 0.5
    }
$!XYLineAxis 
  YDetail 1
    {
    CoordScale = Log
    RangeMin = 1.4110780099940711807E-08
    RangeMax = 0.081437691515018104105
    GRSpacing = 0.01
    }
$!FrameControl ActivateByNumber
  Frame = 1
$!SetStyleBase Config
