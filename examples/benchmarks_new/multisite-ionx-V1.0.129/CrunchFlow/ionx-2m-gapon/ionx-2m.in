TITLE
! surface complexation - example problem by Crunchflow
END
 
DATABASE
datacom_mingliang_simple_new.dbs
END

RUNTIME
time_units      hours
timestep_max    0.02 
timestep_init   1.e-17
debye-huckel    true
lag_activity    true
graphics        tecplot
database_sweep  false
hindmarsh       true
time_tolerance  0.01
correction_max  10.0
gimrt           true
master_variable H+
speciate_only   false
!!restart         pre1_FMC2.rst
screen_output   100
END

OUTPUT
time_units    hours
spatial_profile  10.0  20.0 50.0 200.0   
time_series_at_node      MingliangEffluent2.out  100 1  1
time_series_print        all            
time_series_interval     10
!!MakeMovie              true
END


POROSITY
!!macroporosity
fix_porosity       0.25
porosity_update    false
END

TEMPERATURE
set_temperature      25.0
END


PRIMARY_SPECIES
H+
SO4--
Zn++
Pb++
Ca++
Mg++
K+
Na+
!Fe+++
END

SECONDARY_SPECIES
OH-
HSO4-
CaSO4(aq)
CaOH+
CaHSO4+
KSO4-
KOH(aq)
MgSO4(aq)
MgOH+
NaSO4-
NaOH(aq)
PbOH+  
PbSO4(aq)     
Pb(OH)2(aq)  
Pb(SO4)2--
Pb(OH)3-
Pb2OH+++   
Pb(OH)4--
ZnOH+
ZnSO4(aq)
Zn(OH)2(aq)
Zn(SO4)2--
Zn(OH)3-
Zn(OH)4--
END

ION_EXCHANGE
!exchange X- on Quartz
!exchange X- on Montmor-MX80
exchange X-
exchange Y-
!convention Gaines-Thomas
convention Gapon
END


!MINERALS  
!Montmor-MX80 
!Calcite
!Gypsum -rate -3
!Quartz
!K-Feldspar
!END

!GASES
!CO2(g)
!END

DISCRETIZATION 
distance_units  meters
xzones          1  0.08  99  0.16  1  0.08
END
 
Condition infiltration_solution
!!Infiltration solution 
units           molar
pH               3.0
SO4--            3.6435e-3
Zn++             1.0e-3
Pb++             1.0e-3
Ca++             1.0e-3
Mg++             1.0e-10
K+               1.0e-10
Na+              1.0e-10
!Fe+++                1.00e-10
X-   -cec          0.0
Y-   -cec          0.0
SoildDensity     0.0
END

Condition initial_condition
units            molar
pH               8.00
SO4--            5.147e-4 charge
Zn++             1.0e-7
Pb++             1.0e-7
Ca++             1.0e-10
Mg++             1.0e-5
K+               1.0e-5
Na+              1.0e-3
!Fe+++                1.00e-10  
!!Exchanger  -cec in eq/gram_mineral
X-   -cec  6.597E-06
Y-   -cec  7.330E-07
SolidDensity   2500.0  !  1875.0/(1-0.25)
END

Condition initial_condition_right
units            molar
pH               8.00
SO4--            5.147e-4  charge
Zn++             1.0e-7
Pb++             1.0e-7
Ca++             1.0e-10
Mg++             1.0e-5
K+               1.0e-5
Na+              1.0e-3
!Fe+++                1.00e-10  
!!Exchanger  -cec in eq/gram_mineral
X-   -cec  2.932E-06
Y-   -cec  4.398E-06
SolidDensity   2500.0  !  1875.0/(1-0.25)
END

INITIAL_CONDITIONS
initial_condition   1-50
initial_condition_right 51-101
END

BOUNDARY_CONDITIONS
X_begin   infiltration_solution   Flux
X_end     initial_condition       Flux
END

TRANSPORT
!distance_units   meters
!time_units       second
fix_diffusion     0.0      !1.00e-9
dispersivity   0.0          !0.01
END

FLOW
distance_units  meters
time_units  seconds
constant_flow  8.7500E-05   !2.3e-9
!! m/s (Darcy velocity)
END

 
 

