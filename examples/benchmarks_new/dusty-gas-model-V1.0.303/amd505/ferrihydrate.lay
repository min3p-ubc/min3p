  NAME = 'vol gyps' 
  ASSIGN
    {
    ZONE = 3
    XAXISVAR = 8
    YAXISVAR = 3
    XAXIS = 3
    }
  LINES
    {
    COLOR = GREEN
    LINETHICKNESS = 0.8
    }
  SYMBOLS
    {
    COLOR = GREEN
    FILLCOLOR = GREEN
    }
  BARCHARTS
    {
    COLOR = GREEN
    FILLCOLOR = GREEN
    }
  ERRORBARS
    {
    COLOR = GREEN
    }
$!XYAXIS 
  XDETAIL 1
    {
    RANGEMIN = -0.0001
    RANGEMAX = 0.0008
    GRSPACING = 0.0002
    }
$!XYAXIS 
  XDETAIL 2
    {
    AXISPOSITION = 88
    RANGEMIN = -3.73696899414
    RANGEMAX = 0.278621405363
    GRSPACING = 1
    }
$!XYAXIS 
  XDETAIL 3
    {
    AXISPOSITION = 91
    RANGEMIN = 1.00000001335E-010
    RANGEMAX = 0.212537795305
    GRSPACING = 0.1
    }
$!XYAXIS 
  YDETAIL 1
    {
    RANGEMIN = 0
    RANGEMAX = 2
    GRSPACING = 0.25
    }
$!XYAXIS 
  DEPXTOYRATIO = 1
$!REMOVEVAR |LFDSFN1|
$!SETSTYLEBASE CONFIG
