7  'c2hcl3' -0.500 'mno4-1' -1.000  'h2o' -1.000  'co3-2' 1.000  'cl-1' 1.500  'h+1' 2.500  'mno2(aq)' 1.000
0.000                            !rate constant
2                                !fractional order terms  
'c2hcl3'  1.000     
'mno4-1'  1.000     
2                                !monod and threshold terms
'c2hcl3'   5.0d-6   1.0d0
'mno4-1'   6.3d-9   2.0d0
0                                !inhibition and toxicity terms (aqueous phase)
0                                !inhibition and toxicity terms (solid phase)
