!1.0d-20   4.919d-18  0.00d0     ;phimin, scalfac, supsatm

!5.236d-8  .false.   'constant'  ;phim, minequil, update_type  - '235u-yield-7he

!1.0d-20   3.123d-17  0.00d0     ;phimin, scalfac, supsatm

