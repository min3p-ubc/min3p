#!MC 1000
$!VarSet |LFDSFN1| = '"perm3_2.gsv"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "calcite" "gypsum" "porosity" "hydraulic conductivity"'
$!VarSet |LFDSFN2| = '"perm3_1.gsv"'
$!VarSet |LFDSVL2| = '"x" "y" "z" "calcite" "gypsum" "porosity" "hydraulic conductivity"'
$!VarSet |LFDSFN3| = '"perm3_3.gsv"'
$!VarSet |LFDSVL3| = '"x" "y" "z" "calcite" "gypsum" "porosity" "hydraulic conductivity"'
$!VarSet |LFDSFN4| = '"perm3_4.gsv"'
$!VarSet |LFDSVL4| = '"x" "y" "z" "calcite" "gypsum" "porosity" "hydraulic conductivity"'
$!VarSet |LFDSFN5| = '"perm3_5.gsv"'
$!VarSet |LFDSVL5| = '"x" "y" "z" "calcite" "gypsum" "porosity" "hydraulic conductivity"'
$!VarSet |LFDSFN6| = '"perm3_6.gsv"'
$!VarSet |LFDSVL6| = '"x" "y" "z" "calcite" "gypsum" "porosity" "hydraulic conductivity"'
$!VarSet |LFDSFN7| = '"perm3_7.gsv"'
$!VarSet |LFDSVL7| = '"x" "y" "z" "calcite" "gypsum" "porosity" "hydraulic conductivity"'
$!SETSTYLEBASE FACTORY
$!PAPER 
  BACKGROUNDCOLOR = WHITE
  ISTRANSPARENT = YES
  ORIENTPORTRAIT = NO
  SHOWGRID = YES
  SHOWRULER = YES
  SHOWPAPER = YES
  PAPERSIZE = LETTER
  PAPERSIZEINFO
    {
    LETTER
      {
      WIDTH = 8.5
      HEIGHT = 11
      LEFTHARDCLIPOFFSET = 0.125
      RIGHTHARDCLIPOFFSET = 0.125
      TOPHARDCLIPOFFSET = 0.125
      BOTTOMHARDCLIPOFFSET = 0.125
      }
    }
  RULERSPACING = ONEINCH
  PAPERGRIDSPACING = HALFINCH
  REGIONINWORKAREA
    {
    X1 = -0.05
    Y1 = -0.05
    X2 = 11.05
    Y2 = 8.55
    }
$!COLORMAP 
  CONTOURCOLORMAP = SMRAINBOW
$!COLORMAPCONTROL RESETTOFACTORY
### Frame Number 1 ###
$!READDATASET  '|LFDSFN1|' 
  INITIALPLOTTYPE = XYLINE
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL1|' 
$!REMOVEVAR |LFDSVL1|
$!REMOVEVAR |LFDSFN1|
$!READDATASET  '|LFDSFN2|' 
  INITIALPLOTTYPE = XYLINE
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  READDATAOPTION = APPEND
  RESETSTYLE = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL2|' 
$!REMOVEVAR |LFDSVL2|
$!REMOVEVAR |LFDSFN2|
$!READDATASET  '|LFDSFN3|' 
  INITIALPLOTTYPE = XYLINE
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  READDATAOPTION = APPEND
  RESETSTYLE = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL3|' 
$!REMOVEVAR |LFDSVL3|
$!REMOVEVAR |LFDSFN3|
$!READDATASET  '|LFDSFN4|' 
  INITIALPLOTTYPE = XYLINE
  INCLUDETEXT = NO
  INCLUDEGEOM = NO
  READDATAOPTION = APPEND
  RESETSTYLE = NO
  VARLOADMODE = BYNAME
  VARNAMELIST = '|LFDSVL4|' 
$!REMOVEVAR |LFDSVL4|
$!REMOVEVAR |LFDSFN4|
$!READDATASET  '|LFDSFN5|' 
