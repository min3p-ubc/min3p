  ISOVALUE3 = 0.367291752249
  MARCHINGCUBEALGORITHM = CLASSICPLUS
$!GLOBALSLICE 
  BOUNDARY
    {
    SHOW = NO
    }
$!FIELDLAYERS 
  SHOWMESH = NO
  SHOWCONTOUR = YES
$!ATTACHTEXT 
  ANCHORPOS
    {
    X = 2.53679634094
    Y = 94.6335646141
    }
