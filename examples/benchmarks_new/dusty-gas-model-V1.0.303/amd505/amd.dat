! amd.dat
! Benchmark Problem: Acid Mine Drainage
! 
!
! Data Block 1: global control parameters
! ---------------------------------------------------------------------------
!
'global control parameters'
'Benchmark Problem: Acid Mine Drainage'
.true.                       ;varsat_flow
.true.                       ;steady_flow
.false.                      ;fully_saturated
.true.                      ;reactive_transport
'done'
!
! Data Block 2: geochemical system
! ---------------------------------------------------------------------------
!
'geochemical system'

'use new database format'

'database directory'
'min3p-database'

'components'
8                            ;number of components (nc-1)
'fe+2'                       ;component names
'h+1'
'so4-2'
'co3-2'
'fe+3'
'o2(aq)'
'n2(aq)'
'ca+2'

'redox couples'
1                             ;number of redox couples (nr)
'fe+2'  'fe+3'                ;names of redox couples

'secondary aqueous species'
11                            ;number of secondary aqueous species (nx)
'h2co3aq'                     ;names of secondary aqueous species
'feoh2+'
'feoh3aq'
'feoh+2'
'hso4-'
'oh-'
'hco3-'
'feoh4-'
'feso4aq'
'h2so4(aq)'
'h2(aq)'

'gases'
3                              ;number of gases (ng)
'o2(g)'                        ;names of gases 'co2(g)'
'co2(g)'
'n2(g)'

'minerals'
4                              ;number of minerals (nm)
'ferrihydrite'                 ;mineral names
'pyrite-so4'
'calcite'
'gypsum'

!'excluded minerals'
!1                              ;number of excluded minerals (nmx)
!'siderite'                     ;names of excluded minerals

'done'

!
! Data Block 3: spatial discretization
! ---------------------------------------------------------------------------
!
'spatial discretization'
1                             ;number of discretization intervals in x
1                             ;number of control volumes in x
0. 1.0                        ;xmin,xmax
1                             ;number of discretization intervals in y
1                             ;number of control volumes in y
0. 1.0                        ;ymin,ymax
1                             ;number of discretization intervals in z
40                            ;number of control volumes in z
0.0 2.0                       ;zmin,zmax
'done'
!
! Data Block 4: time step control - global system
! ---------------------------------------------------------------------------
!
'time step control - global system'
'years'                       ;time unit
0.0                           ;time at start of solution
5.0d+1                        ;final solution time
1.0d-2                        ;maximum time step
1.d-20                        ;minimum time step
'done'
!
! Data Block 5: control parameters - local geochemistry
! ---------------------------------------------------------------------------
!
'control parameters - local geochemistry'

'finite minerals'
.true.                        ;update mineralogical parameters

'newton iteration settings'
1.d-4                         ;factor for numerical differentiation
1.d-6                         ;convergence tolerance

'maximum ionic strength'
1.0d0                         ;max. ionic strength

'minimum activity for h2o'
0.5d0                         ;min. activity for h2o

'output time unit'
'days'                        ;time unit (local chemistry)

'done'
!
! Section 6: control parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'control parameters - variably saturated flow'

'mass balance settings'
.true.                        ;compute mass balance

'input units for boundary and initial conditions'
'hydraulic head'              ;input unit

'upstream weighting'
.true.                        ;upstream weighting

'compute underrelaxation factor'
100.0                         ;max. allowed update

'newton iteration settings'
1.0d-6                        ;increment for numerical differentiation
800                           ;max. number of newton iterations
1.0d-4                        ;convergence tolerance
0.3                           ;sw_star

'solver settings'
0                             ;incomplete factorization level
100                           ;max. number of solver iterations
0                             ;solver information level
1.0d-7                        ;solver residual tolerance
1.0d-7                        ;solver update tolerance
.true.                        ;rcm ordering

'done'
!
! Section 7: control parameters - reactive transport
! ---------------------------------------------------------------------------
!
'control parameters - reactive transport'

'redox reactions'
.true.                        ;equilibrium redox reactions

'mass balance settings'
.true.                        ;compute mass balance

'spatial weighting'
'upstream'                    ;spatial weighting

'activity update settings'
'no_update'                   ;type of activity update

'tortuosity correction'
'millington'                       ;Millington-Quirk tortuosity correction

'user specified underrelaxation factor'
0.7d0

'newton iteration settings'
1.d-4                         ;increment h for numerical differentiation
15                            ;anticipted number of Newton iterations
15                            ;max. number of Newton iterations
1.0d0                         ;anticipated update in log cycles
3.0d0                         ;maximum update in log cycles
1.d-6                         ;convergence tolerance (global system)

'solver settings'
0                             ;incomplete factorization level
100                           ;max. number of solver iterations
0                             ;information level
1.d-9                         ;solver residual tolerance
1.d-9                         ;solver update tolerance
.true.                        ;rcm ordering

'skipped time steps in log file'
0

'gas advection'

'done'
!
! Section 8: output control
! ---------------------------------------------------------------------------
!
'output control'

'output of spatial data'
8                             ;number of output times (spatial data)
1.0d+0 5.0d+0 1.0d+1 2.0d+1
2.5d+1 3.0d+1 4.0d+1 5.0d+1   ;specified output times (spatial data)

'output of transient data'
1                             ;number of output locations (transient data)
2                             ;timesteps between output (transient data)
1                             ;control volume numbers (transient data)

'done'

!
! Section 9: physical parameters - porous medium
! ---------------------------------------------------------------------------
!
'physical parameters - porous medium'
1

! ---------------------------------------------------------------------------
'number and name of zone'
1
'vadose zone'
0.50                          ;porosity

'extent of zone'
0.0 1.0  0.0 1.0 0.0 2.0

'end of zone'

'done'
!
! Section 10: physical parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'physical parameters - variably saturated flow'

! ---------------------------------------------------------------------------
'vadose zone'

'hydraulic conductivity in z-direction'
2.00d-7                       ;K_zz

'specific storage coefficient'
1.0d-5

'soil hydraulic function parameters'
0.05                          ;residual saturation
1.0                          ;van genuchten - alpha
2.15                           ;van genuchten - n
0.5                          ;expn
0.0                           ;air entry pressure

'end of zone'

'done'

!
! Section 11: physical parameters - reactive transport
! ---------------------------------------------------------------------------
!
'physical parameters - reactive transport'

'diffusion coefficients'
1.0d-9                        ;free diffusion coefficient in water
1.80d-5                       ;free diffusion coefficient in air

'dusty gas model'
1.635d-5                       ;o2-co2
2.083d-5                       ;o2-n2
1.649d-5                       ;co2-n2
2.04d-5                        ;o2
1.46d-5                        ;co2x 
1.75d-5                        ;n2

'wilke viscosity'
2.04d-5                        ;o2
1.46d-5                        ;co2x 
1.75d-5                        ;n2

! ---------------------------------------------------------------------------
'vadose zone'

'longitudinal dispersivity'
0.0                           ;longitudinal dispersivity

'end of zone'

'done'
!
! Section 12: initial condition - variably saturated flow
! ---------------------------------------------------------------------------
!
'initial condition - variably saturated flow'
1                             ;number of zones
'read initial condition from file'
! ---------------------------------------------------------------------------
!'number and name of zone'
!1
!'zone 1'

!'initial condition'
!0.0                          ;hydraulic head

!'extent of zone'
!0.0 1.0  0.0 1.0  0.0 2.0

'end of zone'

'done'
!
! Section 13: boundary conditions - variably saturated flow
! ---------------------------------------------------------------------------
