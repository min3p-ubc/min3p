"CO2 sequestration in ultramafic tailings"			

! This model includes  

! 

! 1) cover

! 2) rainfall events

!Trying to reproduce Massmann and Farrier (1992) paper

! Section 1: global control parameters                                      			

! --------------------------------------------------------------------------			

!   			

'global control parameters'                                                 			

'preconditioning - wetland Leuna A2'                                        			

.true.                        ;varsat_flow                                  			

.true.                       ;steady_flow                                  			

.false.                       ;fully_saturated                              			

.true.                        ;reactive_transport                           			

.false.                       ;plant_uptake and physical evaporation	





!'density dependent flow'



!'energy balance' 

			

!'restart' 



'done'                                                                      			

!   			

! Section 2: geochemical system                                             			

! --------------------------------------------------------------------------			

!   			

'geochemical system'			

			

'use new database format'



'use pitzer model'



'use macinnes convention' 

			

'database directory'                                                        

'databaseAH'                                          			

			                                                                    			

			

'define temperature'			

25			

			

			

'components'                                                                			

5                               ;number of components (nc-1)                			

'cl-1'

'na+1'

'h+1'

'n2(aq)'

'h4sio4'



'secondary aqueous species'                                                 			

1                 ;number of secondary aqueous species

'oh-' 





			

'gases'                                                                     			

1                             ;number of gases			

'n2(g)'

			

'minerals'                                                                  			

1            ;number of minerals	

'quartz'

			

			

'done'                                                                      			

!   			

! Section 3: spatial discretization                                         			

! --------------------------------------------------------------------------			

!   			

'spatial discretization'                                                    			

1                             ;number of discretization intervals in x			

1                             ;number of control volumes in x			

0.0  1.0                      ;xmin,xmax"			

1                             ;number of discretization intervals in y      			

1                             ;number of control volumes in y               			

0. 1.0                        ;ymin,ymax                                    "			

1

100                           ;number of discretization intervals in z

0.0  20.0



'done'                                                                      			

!   			

! Section 4: time step control - global system                              			

! --------------------------------------------------------------------------			

!   			

'time step control - global system'                                         			

'days'                       ;time unit                                     			

0.0                          ;time at start of solution                     			

4.0d0                        ;final solution time                           			

0.1d0                        ;maximum time step			

1.0d-7                       ;minimum time step			

'done'			

			

!   			

! Section 5: control parameters - local geochemistry                        			

! --------------------------------------------------------------------------			

!   			

'control parameters - local geochemistry'                                   			

			

'finite minerals'                                                           			

.true.                        ;update geometrical parameters of minerals    			

			

'newton iteration settings'                                                 			

1.d-4                         ;factor for numerical differentiation         			

1.d-6                         ;convergence tolerance                        			

			

'maximum ionic strength'                                                    			

50.0d0                         ;max. ionic strength                          			

			

'minimum activity for h2o'                                                  			

0.01d0                         ;min. activity for h2o                        			

			

'output time unit'                                                          			

'days'                        ;time unit (local chemistry)                  			

			

'done'                                                                      			

			

!   			

! Section 6: control parameters - variably saturated flow                   			

! --------------------------------------------------------------------------			

!   			

'control parameters - variably saturated flow'                              			

                         			

	

'mass balance'		



!'density model' 

!'pitzer' 



'upstream factor for flow equation'

1.0d0



'iterative solver'

			

'input units for boundary and initial conditions'                           			

'pressure head'              ;input unit 



'input units for media permeability'

'hydraulic conductivity'

			

'upstream weighting'                                                        			

.true.                       .true.                        ;upstream weight			

		



'variable density parameters'

1000.0d0                      ;freshwater density g/L

0.0d0                         ;linear density coefficient d(rho)/d(TDS)

70                            ;max # Picard flow-RT iterations

25                             ;Picard iteration target (# iterations)

0.1d0                         ;maximum density update: Picard convergence g/L

1.0d50                        ;Courant criteria target

			

'newton iteration settings'			

1.0d-4                        ;increment for numerical differentiation			

200                           ;max. number of newton iterations			

1.0d-7                        ;convergence tolerance			

0.8                           ;sw_star			

			

'solver settings'			

0                             ;incomplete factorization level			

100                           ;max. number of solver iterations			

1                             ;solver information level			

1.0d-11                       ;solver residual tolerance			

1.0d-11                       ;solver update tolerance			

.true.                        ;rcm ordering			

			

'done'	

!   			

! Section 7: control parameters - reactive transport                        			

! --------------------------------------------------------------------------			

!   			

'control parameters - reactive transport'                                   			

			

'update porosity'



'update permeability'    			

			

'mass balance settings'                                                     			

.true.                        ;compute mass balance                         			

			

'spatial weighting'                                                         			

'upstream'                     ;spatial weighting   'upstream'  'centered'         			

			

'activity update settings'                                                  			

'time_lagged'                 ;type of activity update                      			

			

'tortuosity corrections'                                                    			

.false.                       ;Millington-Quirk tortuosity correction			





'gas advection'

'cumulative mole fractions'

'enable gravity for gas phase'	

			

			

'newton iteration settings'                                                 			

1.0d-4                        ;increment h for numerical differentiation    			

50                            ;anticipated number of Newton iterations      			

100                           ;max. number of Newton iterations             			

0.1                           ;anticipated update in log cycles    => increase time step more slowly			

0.3                        ;maximum update in log cycles   !2.0d-2              			

1.d-10                         ;convergence tolerance (global system)        			

			

'solver settings'                                                           			

0                             ;incomplete factorization level               			

100                           ;max. number of solver iterations             			

1                             ;solver information level                     			

1.d-11                         ;solver residual tolerance                    			

1.d-11                         ;solver update tolerance                      			

.true.                        ;rcm ordering                                 			

			

'done'                                                                      			

