! Xe isotopes-ingrowth.dat

! batch test example - noble gas ingrowth

! Ballentine, Chris J. / Burnard, Pete G., 2002-01

! Production, Release and Transport of Noble Gases in the Continental Crust 

! The ingrowth of xenon isotopes is related to fission of 238U and Th 

!    (Ballentine and Burnard, 2002). 

!   

! Data Block 1: global control parameters

! ---------------------------------------------------------------------------

!

'global control parameters'

'Batch problem - Ingrowth of  Ne isotopes'

.true.                        ;varsat_flow

.true.                        ;steady_flow

.true.                        ;fully_saturated

.true.                        ;reactive_transport



'append results'



'done'



! Data Block 2: geochemical system

! ---------------------------------------------------------------------------

!

'geochemical system'



'use new database format'



'database directory'

'..\database'



'components'

5  ;16                            ;number of components (nc-1)

!'4he(aq)'                     ;component names

!'3he(aq)'                      

!'20ne(aq)'

!'21ne(aq)'

!'22ne(aq)'

!'36ar(aq)'

!'38ar(aq)'

!'40ar(aq)'

!'83kr(aq)' 

!'84kr(aq)'

!'86kr(aq)'

'129xe(aq)' 

'131xe(aq)' 

'132xe(aq)' 

'134xe(aq)' 

'136xe(aq)' 





'secondary aqueous species'

0                             ;number of secondary aqueous species

!                             ;names of secondary aqueous species



!old format, noble gas related reactions are defined in mineral database.

!'minerals'

!3                             ;number of minerals (nm)

!'238u-yield-8he'              ;mineral names

!'235u-yield-7he'

!'232th-yield-6he'



!scaling factors are not required when log rate constant is specified in the database or mineral input.

!'scaling factors of mineral reactivity'

!1.0e0  ;4.919e-18   ; s-1, = 1.55 x 10-10 yr-1

!1.0e0  ;3.123e-17   ; s-1, = 9.85 x 10-10 yr-1

!1.0e0  ;1.570e-18   ; s-1, = 4.95 x 10-11 yr-1



!new keyword to activate noble gas ingrowth model, any subset of noble gases 

!can be considered, neutron generation only needs to be calculated if noble gases 

!are generated through thermal neutron capture



'noble gas ingrowth'       !new keyword to activate noble gas ingrowth

5   ;16                         !number of noble gas isotopes to be considered

!'4he ingrowth'             !names of noble gas isotopes to be considered

!'3he ingrowth'             !         

!'20ne ingrowth'

!'21ne ingrowth'

!'22ne ingrowth'

!'36ar ingrowth'

!'38ar ingrowth'

!'40ar ingrowth'

!'83kr ingrowth' 

!'84kr ingrowth'

!'86kr ingrowth'

'129xe ingrowth' 

'131xe ingrowth' 

'132xe ingrowth' 

'134xe ingrowth' 

'136xe ingrowth' 



'noble gas ingrowth - radioelements'

4

'235u'

'238u'  

'232th'

'40k'

!'238u+235u'



'noble gas ingrowth - elements'

5    ;8

'na'

'mg'

'al'

'si'

'c' 

'o' 

'cl'

'f'



'noble gas ingrowth - neutron capture elements'

1     ;4

!'6li'

!'35cl'

!'37cl'

'235u'



'done'



