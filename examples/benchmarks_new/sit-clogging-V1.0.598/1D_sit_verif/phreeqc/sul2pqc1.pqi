RATES
########
#Calcite
########
# Example of KINETICS data block for calcite rate:
#	KINETICS 1
#	Calcite
#		-tol    1e-10
#		-m0	 1.e-1
#		-m	 1.e-1
#		-parms	4.0e-8	  1.0e-10
Calcite
  -start
   1 rem	parm(1) = A/V, 1/dm	parm(2) = exponent for m/m0

   10 si_cc = si("Calcite")
   20 if (m <= parm(2)  and si_cc < 0) then goto 200
#   120   moles = parm(1) * (1 - 10^(si_cc))
   120   moles = parm(1) * (1 - sr("Calcite"))
   130   moles = moles * time
   200 save moles
  -end

########
#Anhydrite
########
# Example of KINETICS data block for Anhydrite rate:
#	KINETICS 1
#	Anhydrite
#		-tol    1e-10
#		-m0	 1.e-1
#		-m	 1.e-1
#		-parms	4.0e-9	  0.5e-10
Anhydrite
  -start
   1 rem	parm(1) = A/V, 1/dm	parm(2) = exponent for m/m0

   10 si_cc = si("Anhydrite")
   20 if (m <= parm(2)  and si_cc < 0) then goto 200
#   120   moles = parm(1) * (1 - 10^(si_cc))
   120   moles = parm(1) * (1 - sr("Anhydrite"))
   130   moles = moles * time
   200 save moles
  -end

########
#Halite
########
# Example of KINETICS data block for Halite rate:
#	KINETICS 1
#	Halite
#		-tol    1e-10
#		-m0	 1.e-1
#		-m	 1.e-1
#		-parms	1.16e-8	  0.5e-10
Halite
  -start
   1 rem	parm(1) = A/V, 1/dm	parm(2) = exponent for m/m0

   10 si_cc = si("Halite")
   20 if (m <= parm(2)  and si_cc < 0) then goto 200
#   120   moles = parm(1) * (1 - 10^(si_cc))
   120   moles = parm(1) * (1 - sr("Halite"))
   130   moles = moles * time
   200 save moles
  -end

#######
#CH2O-H2S
#######
# Example of KINETICS data block for CH2O-H2S rate:
#	KINETICS 1
#	CH2O-H2S
#		-tol    1e-10
#		-m0	 1.e-1
#		-m	1.e-1
#		-parms -5.0	 0.1	 .5	 -0.11
CH2O-H2S
-start 
1	REM fs = salinity factor [-], sal = salinity, in [g/L]

10 Ks = 1.62e-3     	#'hyperbolic T^a' 'so4-2'  1.62d-3  1.0d0
12 Ks2 = 2.4e-6		#'hyperbolic T^a' 'so4-2'  2.4d-6   2.0d0
20 Ka = 3.125e-5		#'inhibition T^a' 'o2(aq)' 3.125d-5  1.0d0
23 Kh2s = 3.125e-5	#'inhibition T^a' 'hs-1'   3.125d-5  2.0d0
30 qm = 27.6d-9		# effective rate constant 6.9d-9 [mol l-1 bulk s-1] for MIN3P, for PHREEQC it should be qm/0.25
40 f1 = tot("S(6)")/(Ks + tot("S(6)")) 
42 f11 = tot("S(6)")/(Ks2 + tot("S(6)")) 
50 f2 = 1.0  # Ka /(Ka + tot("O2")) 
60 f3 = Kh2s /(Kh2s + tot("S(-2)")) 
70 rate = qm * f1 * f11 * f11 * f2 * f3 * f3 
80 sal = 0.0e0		# Calculate the salinity (moles * molweight)
85 fs = 1.0e0
86 PI = 3.141592653589790
#90 sal = tot("Ca")* GFW("Ca") + tot("Na")* GFW("Na") + tot("Mg")* GFW("Mg") + tot("K")* GFW("K") + tot("Cl")* GFW("Cl") + tot("S(6)")* GFW("SO4") + tot("C")* GFW("HCO3") + tot("S(-2)")* GFW("HS")  
90 sal = tot("Cl")
100 if (sal < 0.076) then fs = 1.0
130 if (sal > 1.41) then  fs = 0.0
150 if (sal > 0.076 and sal < 1.41) then fs = cos(PI/180*(134.9325337*sal-10.25487256))
#151 PRINT "cos(90*PI()/180) =", cos(90*PI/180)
155 PRINT "fs(cl-= ", tot("CL"), ")=", fs
160 rate = rate * fs
170 moles = rate * TIME 
190 SAVE moles 
200 if (sal < 1.41 and sal > 0.076) then  print "rate = ", rate, "   TIME =", TIME, "   Cl- =", sal

        -end 

SOLUTION 1-200
    temp      25
    pH        5.95
    pe        -3.3471
    redox     pe
    units     mol/kgw
    density   1
	Ca	2.3952E-01    #9600.00
	Na	4.6289E+00  charge   #94000.00  charge
	Mg	1.3985E-01    #3400.00
	K	6.6493E-02    #2600.00
	Cl	 5.4438E+00		#193000.00  
	S(6) 6.2460E-03		#600.00
	C	 1.2665E-03		#76.00
#	S(-2)	3.0237E-15		#1.0e-10
    -water    1 # kg

KINETICS 1-200
	Calcite
		-tol    1e-8
		-m0	 10.83024671   # = 0.1*10^3/(0.25*36.9336)=Vmi*10^3/(n*Vm[i]) in [mol/kgW]
		-m	10.83024671 
		-parms	16.0e-8	  1.0e-10    # MIN3P parm(1) is in the unit of mol/L bulk/s, PHREEQC is in mol/s/1kgW or 1LH2O, porosity is 0.25, 1/0.25=4
		#-parms	4.0e-8	  1.0e-10
	Anhydrite
		-tol    1e-8
		-m0	 27.68884659	# = 0.32*10^3/(0.25*46.228)
		-m	 27.68884659
		-parms	16.0e-9	  0.5e-10
		#-parms	4.0e-9	  0.5e-10
	Halite
		-tol    1e-8
		-m0	 44.2804428  	# = 0.3*10^3/(0.25*27.1)
		-m	 44.2804428
		-parms	4.64e-8	  0.5e-10
		#-parms	1.16e-8	  0.5e-10
#	CH2O-H2S
#		-tol    1e-10
#		-m0	 11.71466667
#		-m	11.71466667
#		-parms	27.6d-9	  1.0e-10
#		#-parms	6.9d-9	  1.0e-10


END



SOLUTION 0 #boundary
    temp      25
    pH        7.0
    pe        3.39   
    redox     pe
    units     mg/kgw
    density   1
	Ca	  8.40
	Na	189.00  charge
	Mg	  0.097
	K	 72.00
	Cl	164.00  
	S(6)  1.0e-10
	C	164.00
#	S(-2)  1.0e-10
#	Oxg 	-6.6110E-24

END


TRANSPORT
    -cells                 200
    -shifts                480
    -time_step             228.57    #457.14 # seconds
    -flow_direction        forward
    -boundary_conditions   constant flux
    -lengths               200*0.08
    -dispersivities        200*0.01
    -correct_disp 	   true
    -diffusion_coefficient 1e-09
    -print_cells           200
    -print_frequency       100
    -punch_cells           200
    -punch_frequency       3
    -warnings              true
PRINT
    -echo_input            false
    -eh                    true
    -equilibrium_phases    false
    -exchange              false
    -gas_phase             false
    -headings              false
    -inverse               false
    -kinetics              false
    -other                 false
    -saturation_indices    false
    -solid_solutions       false
    -species               false
    -surface               false
    -totals                false
    -user_print            false
    -warnings              0
SELECTED_OUTPUT
        -file   sul2pqc-pitzer-r.sel
        -reset  false 
	  -kinetic_reactants	Calcite anhydrite  halite
#       -time       true
#	  -ph
USER_PUNCH
        -head time(h) ca_mol Na_mol Mg_mol K_mol Cl_mol SO4_mol CO3_mol HS_mol pH SI_CH2O_H2S SI_Calcite SI_Anhydrite SI_halite r_CH2O_H2S r_Calcite r_Anhydrite r_halite 
10 PUNCH TOTAL_TIME/3600, TOT("Ca"), TOT("Na"), TOT("Mg"), TOT("K"), TOT("Cl"), TOT("S(6)"), TOT("C"), TOT("S(-2)"), -LA("H+"), SI("CH2O_H2S"), SI("Calcite"), SI("Anhydrite"), SI("Halite"),  KIN_DELTA("CH2O_H2S")/KIN_TIME("CH2O_H2S"), KIN_DELTA("Calcite")/KIN_TIME("Calcite"),KIN_DELTA("Anhydrite")/KIN_TIME("Anhydrite"), KIN_DELTA("Halite")/KIN_TIME("Halite")
END

